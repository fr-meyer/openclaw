{
  "id": "pr-lifecycle-taskflow",
  "name": "PR Lifecycle TaskFlow",
  "description": "Runs exact-head review, bounded remediation, and explicitly authorized merge workflows through durable OpenClaw TaskFlows.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "pr_lifecycle_taskflow"
    ]
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "githubWebhookSecret",
          "expected": "string",
          "ownerKind": "route"
        },
        {
          "path": "brokerEventSecret",
          "expected": "string",
          "ownerKind": "route"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "env",
              "file",
              "exec",
              "store"
            ]
          },
          "provider": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "provider",
          "id"
        ]
      },
      "secretInput": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/secretRef"
          }
        ]
      },
      "validationCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "required": [
          "argv",
          "covers"
        ]
      },
      "remediatorProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "pullRequests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "headBranchPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "baseBranches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "seedWorkspace": {
            "type": "string",
            "pattern": "^/"
          },
          "worktreeRoot": {
            "type": "string",
            "pattern": "^/"
          },
          "allowedWritePaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "requiredTestPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "validationCommands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/validationCommand"
            }
          },
          "publicationMode": {
            "const": "attested-broker"
          },
          "publicationRoute": {
            "type": "string",
            "enum": [
              "exact-lease",
              "workspace-bridge"
            ]
          },
          "commitSubject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "attestationPolicy": {
            "const": "required"
          }
        },
        "required": [
          "schemaVersion",
          "repository",
          "pullRequests",
          "headBranchPattern",
          "baseBranches",
          "seedWorkspace",
          "worktreeRoot",
          "allowedWritePaths",
          "requiredTestPaths",
          "validationCommands",
          "publicationMode",
          "publicationRoute",
          "commitSubject",
          "attestationPolicy"
        ]
      },
      "mergeAuthorization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "authorizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "authorizer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "authorizedAt": {
            "type": "integer",
            "minimum": 1
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "prNumber": {
            "type": "integer",
            "minimum": 1
          },
          "baseRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mergeMethod": {
            "const": "merge"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "policyVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "policyDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "revokedAt": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "supersededBy": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          }
        },
        "required": [
          "schemaVersion",
          "authorizationId",
          "authorizer",
          "authorizedAt",
          "expiresAt",
          "repository",
          "prNumber",
          "baseRef",
          "mergeMethod",
          "sourceRef",
          "policyVersion",
          "policyDigest"
        ]
      },
      "repositoryPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "observe",
              "dogfood",
              "active"
            ]
          },
          "workspace": {
            "type": "string",
            "pattern": "^/"
          },
          "brokerRepoAlias": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "maxLength": 80,
            "description": "Explicit allowlisted Broker repository selector, bound into the merge-policy digest."
          },
          "baseBranches": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "autoMergeBaseBranches": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 16,
            "uniqueItems": true,
            "description": "Exact configured base branches eligible for automatic merge only after complete exact-head review and explicit authorization."
          },
          "autoMergeMethod": {
            "const": "merge",
            "description": "Merge method used only for an explicitly authorized automatic merge."
          },
          "reviewActor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "authorActor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reviewWorkerAgentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "authorWorkerAgentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maxCycles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2,
            "description": "Maximum bounded fix passes for one PR lifecycle; the final exact-head re-review still runs."
          },
          "maxRetries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "wallTimeMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 10080
          },
          "maxParallelPrs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "Max same-repo flows that may hold a running review or remediator. Extra ready PRs stay queued. Default 1."
          },
          "allowForks": {
            "type": "boolean"
          },
          "ownerSessionKey": {
            "type": "string",
            "minLength": 1
          },
          "fixerModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Pinned primary fixer selector. Configure a concrete non-auto selector for active remediation."
          },
          "fixerFallbackModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Distinct fallback selector, available only after a recorded retryable primary infrastructure failure."
          },
          "publisherBrokerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Non-secret identifier of the separately attested publisher broker."
          },
          "publisherAttestationRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Non-secret proof reference for the reviewed publisher identity, forced-command boundary, installation scope, and guarded publication path."
          },
          "remediatorProfile": {
            "$ref": "#/$defs/remediatorProfile",
            "description": "Versioned repository/PR-scoped author profile validated before remediation model spend."
          },
          "mergeAuthorization": {
            "$ref": "#/$defs/mergeAuthorization",
            "description": "Durable scope-bound merge authority checked again immediately before merge."
          },
          "mergeActor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Expected authenticated merge actor login. Required when autoMergeBaseBranches is non-empty."
          }
        },
        "required": [
          "workspace",
          "brokerRepoAlias",
          "baseBranches",
          "reviewActor",
          "authorActor",
          "reviewWorkerAgentId",
          "authorWorkerAgentId"
        ]
      }
    },
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "ownerSessionKey": {
        "type": "string",
        "minLength": 1
      },
      "notificationSessionKey": {
        "type": "string",
        "minLength": 1
      },
      "githubWebhookPath": {
        "type": "string",
        "minLength": 1
      },
      "brokerEventPath": {
        "type": "string",
        "minLength": 1
      },
      "githubWebhookSecret": {
        "$ref": "#/$defs/secretInput"
      },
      "brokerEventSecret": {
        "$ref": "#/$defs/secretInput"
      },
      "recoveryDelayMinutes": {
        "type": "integer",
        "minimum": 5,
        "maximum": 1440
      },
      "maxParallelPrs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16,
        "description": "Default max parallel PRs for repositories that omit maxParallelPrs. Default 1."
      },
      "maxParallelPrsGlobal": {
        "type": "integer",
        "minimum": 1,
        "maximum": 32,
        "description": "Optional ceiling across all repositories. Omit for no global cap."
      },
      "repositories": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/repositoryPolicy"
        }
      },
      "legacyOwnerSessionKeys": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": "Prior controller session keys retained only for owner-key migration and flow discovery."
      },
      "statusAgentIds": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "description": "Agent ids allowed read-only lifecycle status visibility; admit, continue, and recover remain exact-owner-only."
      },
      "expectedRuntimePath": {
        "type": "string",
        "pattern": "^/",
        "description": "Exact durable runtime.mjs load path attested at plugin startup."
      },
      "expectedRuntimeSha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "SHA-256 of the canonical index+runtime+controller+http executable source-set digest; an enabled controller stays inert on absence or mismatch."
      },
      "repositoryBrokerPath": {
        "type": "string",
        "pattern": "^/",
        "description": "Absolute path to the approved repository broker used for PR state, review, and authorized merge operations."
      },
      "remediationCommandPath": {
        "type": "string",
        "pattern": "^/",
        "description": "Absolute path to the bounded remediation command invoked by author workers."
      },
      "remediationRoot": {
        "type": "string",
        "pattern": "^/",
        "description": "Absolute private directory for remediation job bindings and attested evidence."
      }
    },
    "required": [
      "ownerSessionKey",
      "repositories"
    ]
  }
}
