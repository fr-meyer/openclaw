   bindProvider(receipt: SelectedNativeCodexSseProviderReceipt): void;
 }>;
 
+/** Reported counts only; missing or contradictory accounting never becomes zero. */
+export type SelectedNativeCodexSseTokenUsage =
+  | Readonly<{ state: "available"; inputTokens: number; outputTokens: number; totalTokens: number }>
+  | Readonly<{ state: "unavailable"; reason: "missing" | "incomplete" | "invalid" | "inconsistent" }>;
+
+function terminalTokenUsage(value: unknown): SelectedNativeCodexSseTokenUsage {
+  if (value === undefined || value === null) {
+    return Object.freeze({ state: "unavailable", reason: "missing" });
+  }
+  if (!isRecord(value)) {
+    return Object.freeze({ state: "unavailable", reason: "invalid" });
+  }
+  const inputTokens = value.input_tokens;
+  const outputTokens = value.output_tokens;
+  const totalTokens = value.total_tokens;
+  if (inputTokens === undefined || outputTokens === undefined || totalTokens === undefined) {
+    return Object.freeze({ state: "unavailable", reason: "incomplete" });
+  }
+  if (
+    typeof inputTokens !== "number" || !Number.isSafeInteger(inputTokens) || inputTokens < 0 ||
+    typeof outputTokens !== "number" || !Number.isSafeInteger(outputTokens) || outputTokens < 0 ||
+    typeof totalTokens !== "number" || !Number.isSafeInteger(totalTokens) || totalTokens < 0
+  ) {
+    return Object.freeze({ state: "unavailable", reason: "invalid" });
+  }
+  if (!Number.isSafeInteger(inputTokens + outputTokens) || totalTokens !== inputTokens + outputTokens) {
+    return Object.freeze({ state: "unavailable", reason: "inconsistent" });
+  }
+  return Object.freeze({ state: "available", inputTokens, outputTokens, totalTokens });
+}
+
+function sameTokenUsage(
+  left: SelectedNativeCodexSseTokenUsage | undefined,
+  right: SelectedNativeCodexSseTokenUsage,
+): boolean {
+  if (!left || left.state !== right.state) {
+    return false;
+  }
+  if (left.state === "unavailable") {
+    return right.state === "unavailable" && left.reason === right.reason;
+  }
+  return (
+    right.state === "available" && left.inputTokens === right.inputTokens &&
+    left.outputTokens === right.outputTokens && left.totalTokens === right.totalTokens
+  );
+}
+
