index 0000000000000000000000000000000000000000..676897cbc21e59e83ccf5a82de4915e84e168327
--- /dev/null
+++ b/packages/ai/src/transports/openai-responses-request-lifecycle.test.ts
@@ -0,0 +1,108 @@
+import { describe, expect, it } from "vitest";
+import {
+  EventStream,
+  getEventStreamRequestOwner,
+  startEventStreamProducer,
+} from "@openclaw/llm-core/event-stream";
+import {
+  createSelectedNativeCodexSseRequestOwner,
+  readSelectedNativeCodexSseProviderTerminalOutput,
+  selectedNativeCodexSseReview,
+  type SelectedNativeCodexSseProviderReceipt,
+} from "./openai-responses-request-lifecycle.js";
+
+// Original event stream/request-owner code; only admitted host/auth ports are
+// inert. These tests do not execute a provider or grant native run authority.
+const model = { provider: "openai", api: "openai-chatgpt-responses", id: "fixture-model", endpoint: "https://fixture.invalid" };
+function fixture() {
+  let current = true;
+  let resolveProducer = () => {};
+  const assertCurrent = () => { if (!current) throw new Error("Original owner retired"); };
+  const binding = {
+    assertCurrent,
+    assertReceiptCurrent: assertCurrent,
+    assertIssuedModelInput: () => ({ inputSha256: "a".repeat(64), inputBytes: 8 }),
+    bindProvider: (_receipt: SelectedNativeCodexSseProviderReceipt) => {},
+  };
+  const options = {};
+  selectedNativeCodexSseReview.set(options, binding);
+  selectedNativeCodexSseReview.setCredential(options, {
+    binding, credential: {}, hostReceipt: {},
+    port: { assertHost: assertCurrent, assertFinal: assertCurrent },
+  });
+  const stream = new EventStream<Record<string, unknown>>(() => false, event => event);
+  const owner = createSelectedNativeCodexSseRequestOwner(stream, options, model);
+  if (!owner) throw new Error("Missing original request owner");
+  const receipt = getEventStreamRequestOwner(stream) as SelectedNativeCodexSseProviderReceipt;
+  const producer = new Promise<void>(resolve => { resolveProducer = resolve; });
+  startEventStreamProducer(stream, () => producer, owner.reserveProducer);
+  owner.observeFinalAuthorization("fixture-only", "fixture-only", new Headers());
+  owner.beforeIssue(undefined, JSON.stringify({ model: model.id, stream: true, input: [] }), model);
+  return {
+    receipt,
+    revoke: () => { current = false; },
+    async terminal(usage: unknown) {
+      async function* events() {
+        yield { type: "response.completed", response: {
+          id: "fixture-response", model: model.id, status: "completed", usage,
+          output: [{ type: "message", role: "assistant", status: "completed",
+            content: [{ type: "output_text", text: "whole original verdict" }] }],
+        } };
+      }
+      for await (const event of owner.observe(events())) void event;
+    },
+    async drain() { owner.finish(); resolveProducer(); await receipt.sealAndWait(); },
+    read: () => readSelectedNativeCodexSseProviderTerminalOutput(receipt, binding),
+    readCopy: () => readSelectedNativeCodexSseProviderTerminalOutput({ ...receipt }, binding),
+  };
+}
+
+describe("original selected terminal token accounting", () => {
+  it("retains coherent original counts including reported zero without borrowing a mutable payload", async () => {
+    for (const usage of [{ input_tokens: 7, output_tokens: 5, total_tokens: 12 },
+                         { input_tokens: 0, output_tokens: 0, total_tokens: 0 }]) {
+      const f = fixture();
+      const expected = { state: "available", inputTokens: usage.input_tokens,
+        outputTokens: usage.output_tokens, totalTokens: usage.total_tokens };
+      await f.terminal(usage);
+      usage.total_tokens = 999;
+      await f.drain();
+      expect(f.receipt.assertTerminal()[0]?.tokenUsage).toEqual(expected);
+      expect(f.read().text).toBe("whole original verdict");
+    }
+  });
+
+  it("keeps absent, partial, unsafe and inconsistent accounting unavailable without losing raw terminal text", async () => {
+    const cases = [
+      { usage: undefined, reason: "missing" }, { usage: null, reason: "missing" },
+      { usage: {}, reason: "incomplete" },
+      { usage: { input_tokens: 7, output_tokens: 5 }, reason: "incomplete" },
+      { usage: { input_tokens: true, output_tokens: 5, total_tokens: 6 }, reason: "invalid" },
+      { usage: { input_tokens: -1, output_tokens: 5, total_tokens: 4 }, reason: "invalid" },
+      { usage: { input_tokens: 1.5, output_tokens: 5, total_tokens: 6.5 }, reason: "invalid" },
+      { usage: { input_tokens: 7, output_tokens: 5, total_tokens: 13 }, reason: "inconsistent" },
+      { usage: { input_tokens: Number.MAX_SAFE_INTEGER, output_tokens: 1, total_tokens: Number.MAX_SAFE_INTEGER }, reason: "inconsistent" },
+    ];
+    for (const c of cases) {
+      const f = fixture(); await f.terminal(c.usage); await f.drain();
+      expect(f.receipt.assertTerminal()[0]?.tokenUsage).toEqual({ state: "unavailable", reason: c.reason });
+      expect(f.read().text).toBe("whole original verdict");
+    }
+  });
+
+  it("revokes prior terminal closure when the original stream later changes usage", async () => {
+    const f = fixture();
+    await f.terminal({ input_tokens: 7, output_tokens: 5, total_tokens: 12 }); await f.drain();
+    await expect(f.terminal({ input_tokens: 7, output_tokens: 6, total_tokens: 13 })).rejects.toThrow("token usage changed");
+    expect(() => f.receipt.assertTerminal()).toThrow("not terminal");
+    expect(f.read).toThrow("not terminal");
+  });
+
+  it("cannot upgrade missing accounting after closure or read through copied/retired receipt custody", async () => {
+    const f = fixture(); await f.terminal(undefined); await f.drain();
+    await expect(f.terminal({ input_tokens: 0, output_tokens: 0, total_tokens: 0 })).rejects.toThrow("token usage changed");
+    const g = fixture(); await g.terminal({ input_tokens: 0, output_tokens: 0, total_tokens: 0 }); await g.drain();
+    expect(g.readCopy).toThrow("original selected admission");
+    g.revoke(); expect(g.read).toThrow("retired");
+  });
+});
