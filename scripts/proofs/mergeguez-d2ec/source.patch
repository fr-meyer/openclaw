+  try {
+    wire = JSON.parse(request.wireBody);
+  } catch {
+    throw new Error("Original review wire request is invalid JSON");
+  }
+  if (!record(wire)) throw new Error("Original review wire request is not an object");
+  fields(wire, ["commit_id", "event", "body"], ["comments"]);
+  if (
+    canonical(wire) !== request.wireBody ||
+    wire.commit_id !== request.headSha ||
+    wire.event !== request.event ||
+    !text(wire.body, 65535)
+  )
+    throw new Error("Original review wire bytes/head/event changed");
+  const body = wire.body;
+  if (
+    marker(body, "Reviewed head SHA") !== request.headSha ||
+    marker(body, "Reviewed base SHA") !== request.baseSha ||
+    marker(body, "Command comment URL") !== request.commandCommentUrl ||
+    !DIGEST.test(marker(body, "Reviewer source SHA256") ?? "")
+  )
+    throw new Error("Original review body is not bound to its exact request and source");
+  // These are rejection checks only. The root source must separately own full
+  // validated output coverage; descriptive body markers never grant approval.
+  if (
+    request.event === "APPROVE" &&
+    (marker(body, "Coverage complete") !== "true" ||
+      marker(body, "Blocking findings count") !== "0" ||
+      !["approved", "passed", "success"].includes(marker(body, "Status") ?? ""))
+  )
+    throw new Error("Incomplete or blocking original review cannot approve");
+  if (wire.comments !== undefined) {
+    if (!Array.isArray(wire.comments) || wire.comments.length > 80)
+      throw new Error("Original inline review inventory is invalid");
+    for (const comment of wire.comments) {
+      if (!record(comment)) throw new Error("Original inline review comment is invalid");
+      fields(comment, ["path", "line", "side", "body"]);
+      if (
+        !text(comment.path, 1024) ||
+        comment.path.startsWith("/") ||
+        comment.path.split("/").some((part) => part === ".." || !part) ||
+        !Number.isSafeInteger(comment.line) ||
+        Number(comment.line) < 1 ||
+        comment.side !== "RIGHT" ||
+        !text(comment.body, 65535)
+      )
+        throw new Error("Original inline review target is invalid");
+    }
+  }
+  const { requestDigest: digest, ...facts } = request;
+  if (requestDigest(facts) !== digest) throw new Error("Original review request digest changed");
+  const immutable = JSON.parse(canonical(source)) as OriginalRequiredRunReviewPublication;
+  Object.freeze(immutable.request);
+  Object.freeze(immutable);
+  return Object.freeze({
+    source: immutable,
+    request: immutable.request,
+    wire: JSON.parse(request.wireBody) as ReviewRequest,
+    bodyHash: hash(body),
+  });
+}
+
+function sameSource(original: Capture, current: OriginalRequiredRunReviewPublication): void {
+  const next = capture(current);
+  if (canonical(next.source) !== canonical(original.source))
+    throw new Error("Original review source/run/purpose/request changed");
+}
+function matchesReview(
+  value: unknown,
+  saved: Capture,
+  accountId: number,
+): value is Record<string, unknown> {
+  if (
+    !positiveAccountId(accountId) ||
+    !record(value) ||
+    !record(value.user) ||
+    !Number.isSafeInteger(value.id) ||
+    Number(value.id) < 1 ||
+    value.user.id !== accountId ||
+    !sameLogin(value.user.login, REVIEWER) ||
+    value.user.type !== "Bot" ||
+    value.commit_id !== saved.request.headSha ||
+    !text(value.body, 65535) ||
+    value.body !== saved.wire.body ||
+    hash(value.body) !== saved.bodyHash
+  )
+    return false;
+  const state = { APPROVE: "APPROVED", REQUEST_CHANGES: "CHANGES_REQUESTED", COMMENT: "COMMENTED" };
+  return value.state === state[saved.request.event];
+}
+
+export type OriginalRequiredReviewPublicationResult = Readonly<{
+  status: "original-publication-observed-held" | "original-publication-unknown-held";
+  requestDigest: string;
+  reviewId?: number;
+  retryAllowed: false;
+}>;
+
+/** Readonly native-owner port; only the bounded original remote match can mint its token. */
+export function assertOriginalRequiredRunReviewRemoteObservation(
+  observation: unknown,
+  proof: unknown,
+  context: AdmittedRunContext,
+  gatewayOwner: object,
+): Readonly<{ reviewId: number; requestDigest: string; intentDigest: string }> {
+  const original = observation && typeof observation === "object" ? remoteObservations.get(observation) : undefined;
+  if (!original || original.proof !== proof || original.context !== context || original.gatewayOwner !== gatewayOwner)
+    throw new Error("Original review remote observation is copied, foreign or unbound");
+  original.assertCurrent();
+  return original.facts;
+}
+
+/**
+ * The original completion/bootstrap caller supplies only private root proof and
+ * owners. It never supplies tokens, a request DTO, a callback or a permission flag.
+ * Original release/broker/issuer admission remains unavailable. Preparing an
+ * intent or observing a row never grants HTTP; final root custody must validate
+ * the genuine same-source native consume receipt first.
+ */
+type OriginalRequiredReviewPublicationInput = {
+  proof: unknown;
+  context: AdmittedRunContext;
+  gatewayOwner: object;
+};
+
+async function runOriginalRequiredRunReview(
+  input: OriginalRequiredReviewPublicationInput,
+  operation: "publish" | "reconcile",
+): Promise<OriginalRequiredReviewPublicationResult> {
+  // Retain original object identities once; a caller-owned envelope cannot
+  // redirect an in-flight source check after an await.
+  const { proof, context, gatewayOwner } = input;
+  assertOriginalRequiredRunClosureProof(proof, context);
+  const sourceInput = Object.freeze({ proof, context, gatewayOwner });
+  const readIntent = () => readOriginalRequiredRunReviewIntentCustody(proof, context, gatewayOwner);
+  const readSource = () => readOriginalRequiredRunReviewPublication(proof, context, gatewayOwner);
+  const intent = captureIntent(readIntent()); // Readonly authentic preparation; no HTTP grant.
+  if (!proof || typeof proof !== "object") throw new Error("Original review proof is missing");
+  const previous = effects.get(proof);
+  if (operation === "publish" && previous)
+    throw new Error("Original review effect is held; only reconciliation is allowed");
+  if (previous && (previous.digest !== intent.request.requestDigest || previous.intentDigest !== intent.request.intentDigest))
+    throw new Error("Original held review request changed");
+  const effect: Effect = previous ?? {
+    digest: intent.request.requestDigest,
+    intentDigest: intent.request.intentDigest,
+    phase: operation === "publish" ? "preparing" : "unknown-held",
+  };
+  effects.set(proof, effect);
+  const assertIntentCurrent = () => {
+    sameIntent(intent, readIntent());
+    if (effects.get(proof) !== effect || effect.digest !== intent.request.requestDigest ||
+        effect.intentDigest !== intent.request.intentDigest)
+      throw new Error("Original review effect or native intent changed");
+  };
+  const held = (reviewId?: number): OriginalRequiredReviewPublicationResult =>
+    Object.freeze({
+      status: reviewId === undefined ? "original-publication-unknown-held" : "original-publication-observed-held",
+      requestDigest: intent.request.requestDigest,
+      ...(reviewId === undefined ? {} : { reviewId }),
+      retryAllowed: false,
+    });
+  let saved: Capture;
+  try {
+    assertIntentCurrent();
+    if (operation === "publish") {
+      // Reserve and consume using the original per-agent executor before any
+      // credential/probe work. Only its actual commit ACK can mint this receipt.
+      const receipt = await prepareOriginalRequiredRunReviewDispatch(sourceInput);
+      assertIntentCurrent();
+      await bindOriginalRequiredRunReviewPublicationIntent(proof, context, gatewayOwner, receipt);
+      assertIntentCurrent();
+    } else {
+      // A held row is diagnostic. Reconciliation never reserves, consumes or
+      // turns an absent readback into another dispatch permission.
+      await readOriginalRequiredRunReviewIntent(sourceInput);
+      assertIntentCurrent();
+    }
+    saved = capture(readSource());
+    matchesIntent(saved, intent);
+  } catch {
+    effect.phase = "unknown-held";
+    return held();
+  }
+  let identity: PreparedGitHubPublicationIdentity | undefined;
+  let reads = 0;
+  const assertCurrent = () => {
+    assertIntentCurrent();
+    sameSource(saved, readSource()); // Original root privately checks registry/quarantine and purpose.
+    if (
+      effects.get(proof) !== effect ||
+      effect.digest !== saved.request.requestDigest
+    )
+      throw new Error("Original review effect or credential selection changed");
+    if (identity) assertCurrentRequiredReviewGitHubIdentity({ proof, context, gatewayOwner, identity });
+  };
+  const observe = async (reviewId: number, originalObservation: object) => {
+    assertCurrent();
+    assertOriginalRequiredRunReviewRemoteObservation(originalObservation, proof, context, gatewayOwner);
+    const observed = await observeOriginalRequiredRunReviewPublication({ ...sourceInput, reviewId, originalObservation });
+    assertCurrent();
+    // This diagnostic does not grant dispatch. Unknown observation ACK still
+    // blocks required finish even when the remote review itself was seen.
+    if (observed.status !== "observed_held" || observed.reviewId !== reviewId ||
+        observed.requestDigest !== intent.request.requestDigest || observed.intentDigest !== intent.request.intentDigest)
+      throw new Error("Original native review observation commit ACK is unavailable");
+  };
+  const api = async (endpoint: string, method: "GET" | "POST" = "GET"): Promise<unknown> => {
+    if (method === "GET" && ++reads > MAX_READS)
+      throw new Error("Original review read budget exhausted");
+    assertCurrent();
+    const token = identity?.env.GH_TOKEN;
+    if (!token || !sameLogin(identity?.account.login, REVIEWER))
+      throw new Error("Original review Bot credential is unavailable");
+    const request = {
+      method,
+      redirect: "error" as const,
+      headers: {
+        Accept: "application/vnd.github+json",
+        Authorization: "Bearer " + token,
+        "X-GitHub-Api-Version": "2022-11-28",
+        ...(method === "POST" ? { "Content-Type": "application/json" } : {}),
+      },
+      signal: AbortSignal.timeout(30_000),
+      ...(method === "POST" ? { body: saved.request.wireBody } : {}),
+    };
+    // Root source owns a durable unknown-held, once-only intent before allowing
+    // this read. A process WeakMap is only an additional concurrent-call fence.
+    assertCurrent(); // Synchronous combined source/credential check at final fetch egress.
+    const response = await fetch("https://api.github.com/" + endpoint, request);
+    const reader = response.body?.getReader();
+    let drained = false;
+    try {
+      assertCurrent();
+      if (!reader) throw new Error("Original GitHub response body is unavailable");
+      const chunks: Uint8Array[] = [];
+      let size = 0;
+      for (;;) {
+        const next = await reader.read();
+        assertCurrent();
+        if (next.done) {
+          drained = true;
+          break;
+        }
+        size += next.value.byteLength;
+        if (size > MAX_RESPONSE_BYTES)
+          throw new Error("Original GitHub response exceeded its bounded byte limit");
+        chunks.push(next.value);
+      }
