+  };
+  assertPurpose();
+  // A DISTINCT publication borrow follows canonical deletion/registration fences;
+  // its expected identity comes from the original MODEL claim, not a fresh pathname.
+  const execution = captureOpenClawAgentDatabaseExecution(physical.options, { expectedIdentity: physical.identity });
+  const heldCurrent = execution.assertCurrent, heldRun = execution.runExisting, heldRelease = execution.release;
+  const assertCurrent = () => {
+    assertPurpose();
+    if (execution.assertCurrent !== heldCurrent || execution.runExisting !== heldRun || execution.release !== heldRelease || execution.agentId !== physical.agentId || execution.path !== physical.options.path || !isDeepStrictEqual(execution.fileIdentity, physical.identity)) throw new Error("Original publication executor changed");
+    heldCurrent.call(execution); assertPurpose();
+  };
+  let store: Store | undefined;
+  try {
+    assertCurrent();
+    store = await openOpenClawAgentSqliteWorkerStore(physical.options, { execution }, { moduleUrl: new URL("./openclaw-agent-execution.worker.js", import.meta.url), input: undefined }, true);
+    assertCurrent();
+    return { original, request, execution, store, assertCurrent, phase: "opening" };
+  } catch (error) {
+    try { if (store) await store.close(); else await heldRelease.call(execution); }
+    catch (cleanup) { throw new AggregateError([error, cleanup], "Original review borrow setup and cleanup failed"); }
+    throw error;
+  }
+}
+/** At most one attempt per genuine original root proof. Lost ACKs stay diagnostic holds. */
+export async function prepareOriginalRequiredRunReviewDispatch(input: OriginalNativeReviewInput): Promise<OriginalNativeReviewDispatchReceipt | OriginalNativeReviewHeldObservation> {
+  const original = originalInput(input);
+  const existing = owners.get(original.proof);
+  if (existing) { same(existing, original); return diagnostic(existing.request, undefined, true); }
+  if (attempts.has(original.proof)) throw new Error("Original review dispatch attempt is already held");
+  // Authenticate BEFORE marking; an arbitrary proof cannot consume another proof's state.
+  readOriginalRequiredRunReviewIntentCustody(original.proof, original.context, original.gatewayOwner);
+  attempts.add(original.proof);
+  const owner = await open(original);
+  owners.set(original.proof, owner);
+  try {
+    same(owner, original);
+    const reserved = await owner.store.reviewIntent(original, owner.request, "reserve");
+    same(owner, original);
+    if (!reserved?.inserted || reserved.status !== "reserved_held") { owner.phase = "held"; return diagnostic(owner.request, reserved, !reserved); }
