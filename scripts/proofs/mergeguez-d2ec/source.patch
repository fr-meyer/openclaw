+function text(value: unknown, maximum = 256): string {
+  // SQLite binds Unicode scalar text, while JSON can preserve lone UTF-16 surrogates.
+  // Reject ill-formed text rather than permanently splitting scope JSON from stored identity.
+  // With /u, valid surrogate pairs are one astral scalar and remain accepted.
+  if (typeof value !== "string" || !value.length || value.length > maximum || /[\u0000-\u001f\u007f]/.test(value) || /[\uD800-\uDFFF]/u.test(value)) throw new Error("Review intent string is invalid, ill-formed Unicode or unbounded");
