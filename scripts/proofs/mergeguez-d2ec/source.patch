+import { isDeepStrictEqual } from "node:util";
+import type { AdmittedRunContext } from "../agents/admitted-run-context.js";
+import type { RequiredRunClosureProof } from "../agents/required-run-closure.js";
+import { assertOriginalRequiredRunReviewIntentPurpose, readOriginalRequiredRunReviewIntentCustody } from "../agents/required-run-closure.js";
+import type { OriginalSelectedReviewPublicationDatabase } from "../agents/embedded-agent-runner/run/session-bootstrap.js";
+import type { OriginalGatewayNativeCustody } from "../gateway/server-kernel.js";
+import type { SqliteWorkerAdmissionRequest } from "../infra/sqlite-worker-operation-admission.js";
+import type { AgentDatabaseRequestExecutionSource } from "./openclaw-agent-execution-contract.js";
+import { parseNativeReviewIntentRequest, type NativeReviewIntentOperation, type NativeReviewIntentRequest } from "./native-review-publication-intent.types.js";
+
+export type OriginalNativeReviewInput = Readonly<{ proof: RequiredRunClosureProof; context: AdmittedRunContext; gatewayOwner: object }>;
+type Custody = {
+  source: AgentDatabaseRequestExecutionSource; original: OriginalNativeReviewInput;
+  request: NativeReviewIntentRequest; operation: NativeReviewIntentOperation; reviewId?: number;
+  physical: OriginalSelectedReviewPublicationDatabase; bootstrap: OriginalGatewayNativeCustody;
+  assertExecution: typeof import("./openclaw-agent-worker-store.js").assertOriginalNativeReviewSourceExecution;
+  observation?: unknown; assertObservation?: typeof import("../gateway/github-required-review-publication.js").assertOriginalRequiredRunReviewRemoteObservation;
+  phase: "waiting" | "transaction" | "commit" | "closed";
+};
+const retained = new WeakMap<AgentDatabaseRequestExecutionSource, Custody>();
+function current(c: Custody): void {
+  if (retained.get(c.source) !== c || c.phase === "closed") throw new Error("Original review publication source is closed");
+  c.source.assertCurrent(); c.physical.assertCurrent(); c.bootstrap.assertCurrent();
+  c.assertExecution(c.source, c.physical);
+  const facts = readOriginalRequiredRunReviewIntentCustody(c.original.proof, c.original.context, c.original.gatewayOwner);
+  if (facts.agentId !== c.request.agentId || facts.runId !== c.request.runId || facts.instanceId !== c.request.instanceId || facts.sessionKey !== c.request.sessionKey || facts.sessionId !== c.request.sessionId ||
+      c.physical.agentId !== c.request.agentId || c.physical.runId !== c.request.runId || c.physical.sessionKey !== c.request.sessionKey || c.physical.sessionId !== c.request.sessionId ||
+      c.bootstrap.gatewayInstanceId !== c.request.gatewayInstanceId || c.bootstrap.lifecycleGeneration !== c.request.lifecycleGeneration || c.bootstrap.sourceBuildSha256 !== c.request.sourceBuildSha256 || c.bootstrap.sourceBuildScope !== "core-dist-javascript/v1")
