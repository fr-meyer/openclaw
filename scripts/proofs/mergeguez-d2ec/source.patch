+  assertOriginalRequiredRunReviewIntentPurpose(c.original.proof, c.original.context, c.original.gatewayOwner, c.request.request);
+  if (c.operation === "observe") {
+    if (!c.assertObservation || !c.observation) throw new Error("Original remote observation unavailable");
+    const observed = c.assertObservation(c.observation, c.original.proof, c.original.context, c.original.gatewayOwner);
+    if (observed.reviewId !== c.reviewId || observed.requestDigest !== c.request.request.requestDigest || observed.intentDigest !== c.request.request.intentDigest) throw new Error("Original remote observation differs from held intent");
+  }
+  // Descriptor parsing/root validation may observe revocation. Rejoin actual owners last.
+  c.bootstrap.assertCurrent(); c.physical.assertCurrent(); c.assertExecution(c.source, c.physical); c.source.assertCurrent();
+}
+/** Original store attaches its NEW canonical publication borrow, never the retired MODEL executor. */
+export async function bindOriginalNativeReviewPublicationSource(
+  source: AgentDatabaseRequestExecutionSource, original: OriginalNativeReviewInput,
+  input: NativeReviewIntentRequest, operation: NativeReviewIntentOperation, reviewId?: number, observation?: unknown,
+): Promise<() => void> {
+  const request = parseNativeReviewIntentRequest(input);
+  if (retained.has(source)) throw new Error("Original review source already bound");
+  assertOriginalRequiredRunReviewIntentPurpose(original.proof, original.context, original.gatewayOwner, request.request);
+  const { captureOriginalGatewayNativeCustody } = await import("../gateway/server-kernel.js");
+  const bootstrap = captureOriginalGatewayNativeCustody(original.gatewayOwner);
+  const { readOriginalSelectedReviewPublicationDatabase } = await import("../agents/embedded-agent-runner/run/session-bootstrap.js");
+  const physical = readOriginalSelectedReviewPublicationDatabase(original.context);
+  const { assertOriginalNativeReviewSourceExecution } = await import("./openclaw-agent-worker-store.js");
+  if (retained.has(source)) throw new Error("Original review source changed during acquisition");
+  const assertObservation = operation === "observe" ? (await import("../gateway/github-required-review-publication.js")).assertOriginalRequiredRunReviewRemoteObservation : undefined;
+  const custody: Custody = { source, original, request, operation, reviewId, physical, bootstrap, assertExecution: assertOriginalNativeReviewSourceExecution, observation, assertObservation, phase: "waiting" };
+  retained.set(source, custody);
+  try { current(custody); } catch (error) { retained.delete(source); throw error; }
+  return () => { custody.phase = "closed"; retained.delete(source); };
+}
+/** Actual original host transaction and synchronous PRECOMMIT consume the private purpose. */
+export function assertOriginalNativeReviewPublicationSource(source: AgentDatabaseRequestExecutionSource, input: SqliteWorkerAdmissionRequest, agentId: string): void {
+  const custody = retained.get(source);
+  if (!custody || (input.stage !== "transaction" && input.stage !== "commit")) throw new Error("Original review purpose unavailable");
+  const facts = input.facts;
+  if (!facts || typeof facts !== "object" || !("publication" in facts)) throw new Error("Original review native purpose absent");
+  const value = facts.publication;
+  if (!value || typeof value !== "object" || !("kind" in value) || value.kind !== "native-review-publication" || !("operation" in value) || !("request" in value)) throw new Error("Original review native purpose absent");
+  const request = parseNativeReviewIntentRequest(value.request);
+  if (request.agentId !== agentId || value.operation !== custody.operation || !isDeepStrictEqual(request, custody.request) ||
+      (custody.operation === "observe" && (!("reviewId" in value) || value.reviewId !== custody.reviewId))) throw new Error("Original review native purpose changed");
+  if (!((custody.phase === "waiting" && input.stage === "transaction") || (custody.phase === "transaction" && input.stage === "commit"))) throw new Error("Original review native stages out of order");
+  current(custody);
+  custody.phase = input.stage;
+}
