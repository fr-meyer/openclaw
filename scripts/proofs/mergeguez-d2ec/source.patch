+const MAX_SELECTED_TERMINAL_TEXT_BYTES = 1024 * 1024;
+function terminalText(response: Record<string, unknown>): string {
+  if (!Array.isArray(response.output)) throw new Error("Selected terminal output inventory is missing");
+  const parts: string[] = []; let bytes = 0;
+  for (const item of response.output) {
+    if (!isRecord(item)) throw new Error("Selected terminal output item is invalid");
+    if (item.status !== undefined && item.status !== "completed")
+      throw new Error("Selected terminal output item is explicitly incomplete or contradictory");
+    if (item.type === "reasoning") continue;
+    if (item.type !== "message" || item.role !== "assistant" || !Array.isArray(item.content))
+      throw new Error("Selected terminal output is not original assistant text");
+    for (const content of item.content) {
+      if (!isRecord(content) || content.type !== "output_text" || typeof content.text !== "string")
