+++ b/src/infra/diagnostic-tool-audit-owner.ts
@@ -0,0 +1,48 @@
+/** Private original tool-owner pointer transfer; never serialized or admission authority. */
+import type { AgentRunDelegatedAuthority } from "./agent-run-authority.types.js";
+const owners = new WeakMap<object, AgentRunDelegatedAuthority>();
+export function markToolAuditOwner<T extends object>(
+  event: T,
+  authority: AgentRunDelegatedAuthority | undefined,
+): T {
+  if (authority) owners.set(event, authority);
+  return event;
+}
+export function readToolAuditOwner(event: object): AgentRunDelegatedAuthority | undefined {
+  return owners.get(event);
+}
+export function transferToolAuditOwner(source: object, target: object): void {
+  const owner = owners.get(source);
+  if (owner) owners.set(target, owner);
+}
+
+// Private observation of dropped metadata only; no policy, execution or liveness owner.
+const dropObservers = new WeakMap<AgentRunDelegatedAuthority, Set<() => void>>();
+export function observeToolAuditOwnerDrops(
+  authority: AgentRunDelegatedAuthority,
+  observer: () => void,
+): () => void {
+  let observers = dropObservers.get(authority);
+  if (!observers) {
+    observers = new Set();
+    dropObservers.set(authority, observers);
+  }
+  observers.add(observer);
+  return () => {
+    observers?.delete(observer);
+    if (!observers?.size) dropObservers.delete(authority);
+  };
+}
+export function reportToolAuditOwnerDrop(event: object): void {
+  const owner = owners.get(event);
+  if (!owner) return;
+  for (const observer of dropObservers.get(owner) ?? []) {
+    // Required writer invalidation is synchronous. Ordinary diagnostic dispatch
+    // keeps its historical best-effort handling even for unrelated observers.
+    try {
+      observer();
+    } catch {
+      /* Diagnostic failure never grants a positive receipt. */
+    }
+  }
+}
