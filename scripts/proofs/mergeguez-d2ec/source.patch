+  if (!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/u.test(taskId)) throw new Error("Review task identity is invalid");
+  const author = account(data.author), reviewer = account(data.reviewer);
+  if (reviewer.login !== "mergeguez[bot]" || reviewer.id === author.id || reviewer.login.toLowerCase() === author.login.toLowerCase()) throw new Error("Review requires exact reviewer and separate author account");
