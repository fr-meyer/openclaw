+import { readDatabasePathIdentitySync } from "../infra/sqlite-worker-identity.js";
+import { quarantineAgentRunInCurrentProcess } from "../infra/agent-run-registry.js";
+import {
+  commitAgentRunRecoveryQuarantinesInTransaction,
+  reserveAgentRunRecoveryIntentsInTransaction,
+} from "./agent-run-recovery-intents.kernel.js";
+import {
+  parseAgentRunQuarantineRequest, parseAgentRunQuarantineReceipts,
+  type AgentRunQuarantineRequest,
+} from "./agent-run-quarantine.types.js";
+import {
+  assertAgentDatabaseMaintenanceAuthority,
+  invalidateOpenClawAgentDatabaseIntegrityBeforeMutation,
+} from "./openclaw-agent-db-lease.js";
+import { withAgentDatabaseMaintenanceLease } from "./openclaw-agent-db-maintenance-lease.js";
+import {
+  assertOpenClawAgentDatabaseOwner, assertOpenClawAgentDatabaseForMaintenance,
+  migrateOpenClawAgentDatabaseForMaintenance,
+} from "./openclaw-agent-db-maintenance.js";
+import type { OpenClawAgentDatabaseOptions } from "./openclaw-agent-db-contract.js";
+import { resolveOpenClawAgentSqlitePath } from "./openclaw-agent-db.paths.js";
+
+/** Offline denial uses the existing stopped-writer lease, never an ordinary worker source. */
+export async function quarantineLegacyAgentRunsForMaintenance(
+  options: OpenClawAgentDatabaseOptions,
+  input: AgentRunQuarantineRequest,
+  backupPath: string,
+) {
+  const request = parseAgentRunQuarantineRequest(input);
+  const pathname = resolveOpenClawAgentSqlitePath(options);
+  // Capture the physical store before lease acquisition can yield. No later pathname adoption.
+  const identity = readDatabasePathIdentitySync(pathname);
+  if (!identity.key.startsWith("file:")) throw new Error("Maintenance requires existing storage");
+  return withAgentDatabaseMaintenanceLease({ env: options.env }, async (maintenance) => {
+    const assertCurrent = () => {
+      maintenance.signal.throwIfAborted();
+      assertAgentDatabaseMaintenanceAuthority(maintenance);
+      if (!isDeepStrictEqual(readDatabasePathIdentitySync(pathname), identity))
+        throw new Error("Quarantine maintenance physical store changed");
+    };
+    assertCurrent();
+    const before = openNodeSqliteDatabase(resolveExistingSqliteFileUri(pathname));
+    let backupPages: number;
+    try {
+      assertOpenClawAgentDatabaseOwner(before, { agentId: options.agentId, pathname });
+      // The original backup owner writes only this exclusively reserved task target.
+      const reservation = openSync(backupPath, "wx", 0o600);
+      closeSync(reservation);
+      backupPages = await backupNodeSqliteDatabase(before, backupPath);
+      assertCurrent();
+    } finally {
+      clearNodeSqliteKyselyCacheForDatabase(before);
+      before.close();
+    }
+    await migrateOpenClawAgentDatabaseForMaintenance({ agentId: options.agentId, pathname }, maintenance);
+    assertCurrent();
+    invalidateOpenClawAgentDatabaseIntegrityBeforeMutation(pathname, options.env ?? process.env);
+    assertCurrent();
+    const database = openNodeSqliteDatabase(resolveExistingSqliteFileUri(pathname));
+    try {
+      assertOpenClawAgentDatabaseForMaintenance(database, { agentId: options.agentId, pathname });
+      for (const target of request.targets) {
+        assertCurrent();
+        quarantineAgentRunInCurrentProcess(target.runId);
+      }
+      // Separate original native transactions retain the recovery reservation on later failure.
+      const reserve = runSqliteImmediateTransactionSync(database, () => {
+        assertCurrent();
+        const result = reserveAgentRunRecoveryIntentsInTransaction(database, request);
+        assertCurrent();
+        return result;
+      });
+      const receipts = runSqliteImmediateTransactionSync(database, () => {
+        assertCurrent();
+        const result = commitAgentRunRecoveryQuarantinesInTransaction(database, request);
+        assertCurrent();
+        return result;
+      });
+      assertCurrent();
+      return { backupPages, reserve, receipts: parseAgentRunQuarantineReceipts(receipts, request) };
+    } finally {
+      clearNodeSqliteKyselyCacheForDatabase(database);
+      database.close();
+    }
+  });
+}
