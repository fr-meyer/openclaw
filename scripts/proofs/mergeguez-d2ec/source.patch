+    (["agentId", "runId", "instanceId", "sessionKey", "sessionId", "purpose"] as const).some(
+      (key) => source[key] !== intent[key],
+    ) ||
+    (["repository", "prNumber", "headSha", "baseSha", "commandCommentUrl", "reviewer", "event", "requestDigest"] as const).some(
+      (key) => request[key] !== intent.request[key],
+    ) ||
+    publication.bodyHash !== intent.request.bodySha256 ||
+    hash(canonical(wire.comments ?? [])) !== intent.request.inlineCommentsSha256 ||
+    (wire.comments?.length ?? 0) !== intent.request.inlineCommentsCount
