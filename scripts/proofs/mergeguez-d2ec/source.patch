index 00000000..718cef87
--- /dev/null
+++ b/src/state/agent-run-quarantine.schema.ts
@@ -0,0 +1,18 @@
+/** Schema 25 owns non-evicting run revocations. Removing them is unsupported. */
+export const AGENT_RUN_QUARANTINE_SCHEMA_VERSION = 25;
+
+const START = "-- BEGIN AGENT RUN QUARANTINE SCHEMA\n";
+const END = "-- END AGENT RUN QUARANTINE SCHEMA\n";
+
+/** Historical readers must validate only the representation they understood. */
+export function withoutAgentRunQuarantineSchema(schema: string): string {
+  const start = schema.indexOf(START);
+  if (start < 0) {
+    return schema;
+  }
+  const end = schema.indexOf(END, start);
+  if (end < 0 || schema.indexOf(START, start + START.length) >= 0) {
+    throw new Error("Ambiguous agent run quarantine schema boundary");
+  }
+  return schema.slice(0, start) + schema.slice(end + END.length);
+}
diff --git a/src/state/agent-run-quarantine.ts b/src/state/agent-run-quarantine.ts
new file mode 100644
index 00000000..7e7f74ee
--- /dev/null
+++ b/src/state/agent-run-quarantine.ts
@@ -0,0 +1,103 @@
+import { createHash } from "node:crypto";
+import {
+  quarantineAgentRunInCurrentProcess,
+  retireAgentRunInCurrentProcess,
+} from "../infra/agent-run-registry.js";
+import type { AgentRunQuarantineRequest } from "./agent-run-quarantine.types.js";
+import {
+  parseAgentRunWriterRetirementRequest,
+  type AgentRunWriterRetirementRequest,
+} from "./agent-run-writer-retirement.types.js";
+import type { AgentDatabaseRequestExecutionSource } from "./openclaw-agent-execution-contract.js";
+import type { OpenClawAgentDatabaseExecution } from "./openclaw-agent-execution.js";
+
+/** Internal owner API only: this adds no CLI, RPC, permissions or automatic admission. */
+export async function quarantineLegacyAgentRuns(
+  execution: OpenClawAgentDatabaseExecution,
+  source: AgentDatabaseRequestExecutionSource,
+  input: AgentRunQuarantineRequest,
+) {
+  source.assertCurrent();
+  // Clone before yielding; caller mutation cannot redirect either revocation or persistence.
+  const captured = Object.freeze({
+    requestId: input.requestId,
+    targets: Object.freeze(input.targets.map((target) => Object.freeze({ ...target }))),
+  });
+  for (const target of captured.targets) {
+    // Deny first, persist second. On failure the local hold remains; never restore permission.
+    quarantineAgentRunInCurrentProcess(target.runId);
+  }
+  const receipts = await execution.runExisting(source, async (scope) => {
+    await scope.execute({ type: "agent.runs.recovery.reserve", input: captured });
+    source.assertCurrent();
+    const committed = await scope.execute({ type: "agent.runs.quarantine", input: captured });
+    source.assertCurrent();
+    return committed;
+  });
+  source.assertCurrent();
+  if (receipts === undefined) {
+    throw new Error(
+      "Quarantine requires the existing native agent database; recovery remains held",
+    );
+  }
+  return receipts;
+}
+
+/** Rehydrate denial through the original worker; no file-path or DTO grants authority. */
+export async function restoreAgentRunQuarantines(
+  execution: OpenClawAgentDatabaseExecution,
+  source: AgentDatabaseRequestExecutionSource,
+) {
+  const entries = await execution.runExisting(source, (scope) =>
+    scope.execute({ type: "agent.runs.recovery.read", input: undefined }),
+  );
+  source.assertCurrent();
+  if (entries === undefined) {
+    throw new Error(
+      "Quarantine hydration requires the existing native agent database; admission remains held",
+    );
+  }
+  if (
+    entries.complete !== true ||
+    entries.expectedEntries !== entries.records.length ||
+    entries.notAnAdmissionReceipt !== true
+  ) {
+    throw new Error("Native recovery snapshot incomplete; admission remains held");
+  }
+  for (const entry of entries.records) {
+    if (entry.kind === "writer-retired") retireAgentRunInCurrentProcess(entry.runId);
+    else quarantineAgentRunInCurrentProcess(entry.runId);
+  }
+  return entries;
+}
+
+/** Original internal native-owner API. Ordinary request sources cannot retire writers. */
+export async function retireAgentRunWriter(
+  execution: OpenClawAgentDatabaseExecution,
+  source: AgentDatabaseRequestExecutionSource,
+  input: AgentRunWriterRetirementRequest,
+) {
+  source.assertCurrent();
+  const request = parseAgentRunWriterRetirementRequest(input);
+  const committed = await execution.runExisting(source, (scope) =>
+    scope.execute({ type: "agent.runs.writer.retire", input: request }),
+  );
+  source.assertCurrent();
+  if (!committed)
+    throw new Error("Writer retirement requires original native storage; ownership remains held");
+  const retained = parseAgentRunWriterRetirementRequest(committed.request);
+  const requestSha256 = createHash("sha256").update(JSON.stringify(request)).digest("hex");
+  if (
+    committed.kind !== "native-agent-writer-retired" ||
+    committed.notAnAdmissionReceipt !== true ||
+    JSON.stringify(retained) !== JSON.stringify(request) ||
+    committed.requestSha256 !== requestSha256 ||
+    !Number.isSafeInteger(committed.committedAt) ||
+    committed.committedAt < 0
+  ) {
+    throw new Error("Native retirement receipt differs from original terminal ownership");
+  }
+  // This only denies the old ID. No recovery hold is removed and no new run is admitted.
+  retireAgentRunInCurrentProcess(request.runId);
+  return committed;
+}
