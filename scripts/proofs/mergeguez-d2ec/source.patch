+      const decoded = new TextDecoder("utf-8", { fatal: true }).decode(raw);
+      const value: unknown = JSON.parse(decoded);
+      assertCurrent();
+      return value;
+    } finally {
+      try {
+        if (reader && !drained) await reader.cancel();
+      } finally {
+        reader?.releaseLock();
+      }
+    }
