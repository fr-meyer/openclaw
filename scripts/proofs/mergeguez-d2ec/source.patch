diff --git a/scripts/proofs/native-ipc-gateway/driver.mjs b/scripts/proofs/native-ipc-gateway/driver.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..00ae36a77ab6964e97e67fa172a8b0d3fc1012cf
--- /dev/null
+++ b/scripts/proofs/native-ipc-gateway/driver.mjs
@@ -0,0 +1,257 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { mkdir, readFile, readdir, realpath, writeFile } from "node:fs/promises";
+import { networkInterfaces } from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { setTimeout as delay } from "node:timers/promises";
+
+export const ENTRY_PATHS = Object.freeze({
+  driver: "dist/proofs/native-ipc-gateway-driver.js",
+  api: "dist/proofs/native-ipc-gateway-api.js",
+  fixture: "dist/proofs/native-ipc-gateway-fixture.js",
+  sdk: "dist/plugin-sdk/sqlite-runtime.js",
+  gateway: "openclaw.mjs",
+});
+
+export function parseArguments(argv) {
+  const allowed = new Set(["--artifact-root", "--state-root", "--report", "--port"]);
+  const values = new Map();
+  for (let index = 0; index < argv.length; index += 2) {
+    const key = argv[index], value = argv[index + 1];
+    if (!allowed.has(key) || values.has(key) || !value || value.startsWith("--"))
+      throw new Error("Use --artifact-root PATH --state-root FRESH_PATH --report PATH --port NUMBER");
+    values.set(key, value);
+  }
+  for (const key of allowed) if (!values.has(key)) throw new Error(`Missing ${key}`);
+  const port = Number(values.get("--port"));
+  if (!Number.isSafeInteger(port) || port < 1024 || port > 65535) throw new Error("Invalid isolated Gateway port");
+  return { artifactRoot: path.resolve(values.get("--artifact-root")), stateRoot: path.resolve(values.get("--state-root")), report: path.resolve(values.get("--report")), port };
+}
+
+export function gatewayArgv(artifactRoot, port) {
+  return [process.execPath, path.join(artifactRoot, ENTRY_PATHS.gateway), "gateway", "run", "--bind", "loopback", "--auth", "none", "--tailscale", "off", "--port", String(port)];
+}
+
+function errorFacts(error) {
+  return { name: error instanceof Error ? error.name : "unknown", message: error instanceof Error ? error.message : String(error), code: error?.code };
+}
+
+function assertNoExternalInterface() {
+  assert.equal(process.platform, "linux", "Native execution is restricted to the future isolated Linux job");
+  for (const addresses of Object.values(networkInterfaces()))
+    for (const address of addresses ?? []) assert.equal(address.internal, true, "Job network namespace must expose loopback only");
+}
+
+async function loadEntries(artifactRoot) {
+  const loaded = {};
+  for (const [name, relative] of Object.entries(ENTRY_PATHS)) {
+    const filename = path.join(artifactRoot, relative);
+    const resolved = await realpath(filename);
+    assert.equal(resolved.startsWith(`${artifactRoot}${path.sep}`), true, "Entry escaped the accepted artifact root");
+    loaded[name] = { filename: resolved, sha256: createHash("sha256").update(await readFile(resolved)).digest("hex") };
+  }
+  const api = await import(pathToFileURL(loaded.api.filename).href);
+  const sdk = await import(pathToFileURL(loaded.sdk.filename).href);
+  // Actual loaded SDK correspondence, rather than a source declaration or copied receipt.
+  assert.equal(api.openSqliteWorkerStore, sdk.openSqliteWorkerStore);
+  assert.equal(api.runSqliteWorkerStoreOperation, sdk.runSqliteWorkerStoreOperation);
+  assert.equal(await realpath(process.argv[1]), loaded.driver.filename, "Run only the SAME full-build compiled driver entry");
+  return { api, loaded, fixtureUrl: pathToFileURL(loaded.fixture.filename) };
+}
+
+async function nativeIpc(api, fixtureUrl, stateRoot, record) {
+  const pathname = path.join(stateRoot, "ipc.sqlite");
+  const store = await api.openSqliteWorkerStore({ moduleUrl: fixtureUrl, databasePath: pathname, input: undefined });
+  assert.ok(store, "Original broker did not create its task fixture store");
+  const physical = api.readDatabasePathIdentitySync(pathname);
+  let active = true;
+  const assertCurrent = () => {
+    assert.ok(active, "Task fixture request revoked");
+    assert.deepEqual(api.readDatabasePathIdentitySync(pathname), physical);
+  };
+  async function write(type, key, revokeAtCommit = false) {
+    let admission, settlement;
+    const stages = [];
+    const result = await api.runSqliteWorkerStoreOperation(store, scope => scope.execute({ type, input: { key } }), undefined, assertCurrent,
+      operation => {
+        settlement = operation.settled;
+        admission = api.createSqliteWorkerOperationAdmission((request, grant) => {
+          stages.push(request.stage);
+          assert.deepEqual(stages, request.stage === "transaction" ? ["transaction"] : ["transaction", "commit"]);
+          if (revokeAtCommit && request.stage === "commit") active = false;
+          assertCurrent();
+          assert.equal(grant(), true);
+        });
+        return { admission, nativeLocations: [physical.canonicalPath] };
+      });
+    const settled = await settlement;
+    assert.equal(settled.kind, "completed");
+    assert.deepEqual(admission.committed?.facts, result);
+    assert.equal(admission.settlement?.kind, "completed");
+    record({ case: type, stages, result, nativeCommit: admission.committed, nativeSettlement: admission.settlement, brokerSettlement: settled });
+    return result;
+  }
+  try {
+    await write("reserve", "ack");
+    await write("commit", "ack");
+    await write("reserve", "revoked");
+    await assert.rejects(write("commit", "revoked", true));
+    const rows = (await store.execute({ type: "read", input: undefined })).map(row => ({ key: row.key, committed: row.committed }));
+    assert.deepEqual(rows, [{ key: "ack", committed: 1 }, { key: "revoked", committed: 0 }]);
+    record({ case: "revocation", rows, admissionRevoked: active === false });
+  } finally { await store.close(); }
+  // Isolate fault custody from the healthy actor; the original broker owns both generations.
+  const lostPath = path.join(stateRoot, "lost-ack.sqlite");
+  const lost = await api.openSqliteWorkerStore({ moduleUrl: fixtureUrl, databasePath: lostPath, input: undefined });
+  assert.ok(lost);
+  const lostPhysical = api.readDatabasePathIdentitySync(lostPath);
+  let admission, settlement;
+  const admissionFactory = operation => {
+    settlement = operation.settled;
+    admission = api.createSqliteWorkerOperationAdmission((_request, grant) => {
+      assert.deepEqual(api.readDatabasePathIdentitySync(lostPath), lostPhysical);
+      assert.equal(grant(), true);
+    });
+    return { admission, nativeLocations: [lostPhysical.canonicalPath] };
+  };
+  await api.runSqliteWorkerStoreOperation(lost, scope => scope.execute({ type: "reserve", input: { key: "lost" } }), undefined, undefined, admissionFactory);
+  let failure;
+  try {
+    await api.runSqliteWorkerStoreOperation(lost, scope => scope.execute({ type: "lostAck", input: { key: "lost" } }), undefined, undefined, admissionFactory);
+  } catch (error) { failure = error; }
+  assert.ok(failure, "Lost ACK unexpectedly returned a native result");
+  assert.equal(api.hasSqliteWorkerOutcomeUnknown(failure), true, "Original broker must retain unknown outcome");
+  const settled = await settlement;
+  assert.equal(settled.kind, "unknown");
+  assert.equal(admission.committed, undefined, "Readback may not fabricate the lost native ACK");
+  let closeFailure;
+  try { await lost.close(); } catch (error) { closeFailure = errorFacts(error); }
+  const database = api.openNodeSqliteDatabase(api.resolveExistingSqliteFileUri(lostPath), { readOnly: true });
+  let rows;
+  try { rows = database.prepare("SELECT key,committed FROM qualification_reservations").all().map(row => ({ key: row.key, committed: row.committed })); } finally { database.close(); }
+  assert.deepEqual(rows, [{ key: "lost", committed: 1 }]);
+  record({ case: "lost-ack", failure: errorFacts(failure), brokerSettlement: { kind: settled.kind }, nativeCommit: null, durableReadback: rows, closeFailure, ownership: "held-for-reconciliation", notAnAdmissionReceipt: true });
+}
+
+async function maintenanceAndReopen(api, stateRoot, environment, record) {
+  const agentId = "qualification";
+  const pathname = path.join(stateRoot, "agents", agentId, "agent", "openclaw-agent.sqlite");
+  await mkdir(path.dirname(pathname), { recursive: true, mode: 0o700 });
+  const target = api.seedLegacyAgentFixture(pathname, agentId);
+  const backupPath = path.join(stateRoot, "legacy-before-migration.sqlite");
+  const result = await api.quarantineLegacyAgentRunsForMaintenance({ agentId, path: pathname, env: environment }, { requestId: "qualification-maintenance", targets: [target] }, backupPath);
+  assert.equal(result.receipts.length, 1);
+  assert.equal(result.receipts[0].notAnAdmissionReceipt, true);
+  for (const key of ["executionDrain", "providerDrain", "localCleanup", "historicalRetirement"]) assert.equal(result.receipts[0][key], "unknown");
+  const backup = api.openNodeSqliteDatabase(api.resolveExistingSqliteFileUri(backupPath), { readOnly: true });
+  try {
+    assert.equal(backup.prepare("PRAGMA user_version").get().user_version, 24);
+    assert.equal(backup.prepare("SELECT count(*) AS count FROM session_nodes").get().count, 1);
+  } finally { backup.close(); }
+  // Lease is now fully released. This source owns ONLY this isolated task's recovery read.
+  const execution = api.captureOpenClawAgentDatabaseExecution({ agentId, path: pathname, env: environment });
+  let active = true;
+  const source = {
+    assertCurrent() { assert.ok(active); execution.assertCurrent(); },
+    createAdmission(params) {
+      return () => ({ nativeLocations: params.nativeLocations,
+        admission: api.createSqliteWorkerOperationAdmission((request, grant) => {
+          source.assertCurrent(); params.assertCurrent(); params.authorize(request);
+          assert.equal(grant(), true);
+        }, params.attachment) });
+    },
+  };
+  try {
+    const recovery = await api.restoreAgentRunQuarantines(execution, source);
+    assert.equal(recovery.complete, true);
+    assert.equal(recovery.notAnAdmissionReceipt, true);
+    assert.ok(recovery.records.some(row => row.runId === target.runId));
+    for (const key of ["executionDrain", "providerDrain", "localCleanup"]) assert.equal(recovery[key], "unknown");
+    record({ case: "held-lease-backup-migrate-quarantine-reopen", result, recovery, ownership: "durable-denial-held", notAnAdmissionReceipt: true });
+  } finally { active = false; await execution.release(); }
+  await api.closeOpenClawAgentDatabasesAsync();
+  await api.closeOpenClawStateDatabaseByPathAsync(api.resolveOpenClawStateSqlitePath(environment));
+}
+
+async function gateway(api, options, environment, record) {
+  const config = { gateway: { mode: "local", bind: "loopback", auth: { mode: "none" }, tailscale: { mode: "off" } }, models: { catalogRefresh: { enabled: false } }, cron: { enabled: false }, update: { checkOnStart: false }, discovery: { mdns: { mode: "off" } } };
+  const configPath = path.join(options.stateRoot, "openclaw.json");
+  await writeFile(configPath, `${JSON.stringify(config)}\n`, { flag: "wx", mode: 0o600 });
+  const argv = gatewayArgv(options.artifactRoot, options.port);
+  const child = await api.createOwnedStdioProcess({ argv, cwd: options.artifactRoot, env: { ...environment, OPENCLAW_CONFIG_PATH: configPath }, exactEnv: true });
+  let stdout = "", stderr = "", outputOverflow = false;
+  const capture = (previous, chunk) => {
+    if (previous.length + chunk.length > 1024 * 1024) {
+      outputOverflow = true;
+      child.kill("SIGTERM");
+    }
+    return (previous + chunk).slice(0, 1024 * 1024);
+  };
+  child.onStdout(chunk => { stdout = capture(stdout, chunk); });
+  child.onStderr(chunk => { stderr = capture(stderr, chunk); });
+  const probe = api.createConfiguredGatewayLocalProbe(config);
+  const deadline = performance.now() + 90_000;
+  let readiness, startup;
+  try {
+    while (performance.now() < deadline) {
+      readiness = await probe.requestHttp({ host: "127.0.0.1", pathname: "/readyz", port: options.port, timeoutMs: 1000 });
+      startup = await probe.requestHttp({ host: "127.0.0.1", pathname: "/startupz", port: options.port, timeoutMs: 1000 });
+      if (readiness?.statusCode === 200 && startup?.statusCode === 200) break;
+      await delay(100);
+    }
+    assert.equal(readiness?.statusCode, 200, "Full natural Gateway did not become ready");
+    assert.equal(startup?.statusCode, 200, "Full natural Gateway did not complete startup");
+    assert.equal(outputOverflow, false, "Gateway output exceeded the retained observation bound");
+    child.kill("SIGTERM");
+    const cleanup = await api.closeOwnedStdioProcess(child, { graceMs: 10_000 });
+    const exit = await child.wait();
+    assert.equal(cleanup, undefined, "Graceful Gateway required forced owner cleanup");
+    assert.equal(exit.code, 0, "Natural Gateway shutdown failed");
+    record({ case: "full-gateway-startup-ready-graceful-shutdown", argv, startup, readiness, exit, processOwnerExtinctionJoined: true, stdout, stderr });
+  } catch (error) {
+    await api.closeOwnedStdioProcess(child, { graceMs: 10_000 });
+    record({ case: "gateway-failure", error: errorFacts(error), stdout, stderr });
+    throw error;
+  }
+}
+
+export async function main(argv = process.argv.slice(2)) {
+  const options = parseArguments(argv);
+  assertNoExternalInterface();
+  options.artifactRoot = await realpath(options.artifactRoot);
+  await mkdir(options.stateRoot, { mode: 0o700 }); // Existing state, including an empty directory, is refused.
+  assert.equal((await readdir(options.stateRoot)).length, 0);
+  const environment = { PATH: process.env.PATH, HOME: options.stateRoot, LANG: "C.UTF-8", OPENCLAW_STATE_DIR: options.stateRoot, OPENCLAW_CONFIG_PATH: path.join(options.stateRoot, "openclaw.json") };
+  // Secretless namespace: do not inherit credentials, proxy configuration, test/minimal flags or provider settings.
+  for (const key of Object.keys(process.env)) delete process.env[key];
+  Object.assign(process.env, environment);
+  const report = { schema: "openclaw.native-ipc-gateway-observations/v1", artifactProfile: "original-full-production-build-plus-task-internal-entries", priorArtifactParity: "unproved", admissionOrReleaseAcceptance: false, cases: [], ownership: [] };
+  const record = value => report.cases.push(value);
+  let api;
+  try {
+    const entries = await loadEntries(options.artifactRoot);
+    api = entries.api; report.loadedEntries = entries.loaded;
+    await nativeIpc(api, entries.fixtureUrl, options.stateRoot, record);
+    await maintenanceAndReopen(api, options.stateRoot, environment, record);
+    // This Promise consumes original broker Worker.terminate()/slot.exit joins, not PID inference.
+    await api.drainGlobalSingletonLifecycleState("close");
+    report.ownership.push({ owner: "original-global-singleton-broker-close", status: "terminal", workerExitAndSlotJoins: "original-owner-promise" });
+    report.ownership.push({ owner: "lost-ack-and-legacy-writer", status: "held-for-reconciliation", notAnAdmissionReceipt: true });
+    await gateway(api, options, environment, record);
+    report.completed = true;
+  } catch (error) {
+    report.completed = false; report.failure = errorFacts(error);
+    if (api) {
+      try { await api.drainGlobalSingletonLifecycleState("close"); }
+      catch (cleanupError) { report.ownership.push({ owner: "original-pool-close", status: "held-for-reconciliation", failure: errorFacts(cleanupError) }); }
+    }
+    throw error;
+  } finally {
+    // No task directory or durable unknown ownership is evicted, on success or failure.
+    await writeFile(options.report, `${JSON.stringify(report, null, 2)}\n`, { flag: "wx", mode: 0o600 });
+  }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href)
+  main().catch(error => { process.stderr.write(`${error.stack ?? error}\n`); process.exitCode = 1; });
