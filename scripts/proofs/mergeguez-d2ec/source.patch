+    !SHA.test(request.headSha) ||
+    !SHA.test(request.baseSha) ||
+    request.reviewer !== REVIEWER ||
+    !["APPROVE", "REQUEST_CHANGES", "COMMENT"].includes(request.event) ||
+    !text(request.wireBody, MAX_WIRE_BYTES) ||
+    !DIGEST.test(request.requestDigest) ||
+    !text(request.commandCommentUrl, 1024) ||
+    !request.commandCommentUrl.startsWith(
+      "https://github.com/" + request.repository + "/pull/" + request.prNumber + "#issuecomment-",
+    ) ||
+    !/^[1-9][0-9]*$/u.test(
+      request.commandCommentUrl.slice(
+        (
+          "https://github.com/" +
+          request.repository +
+          "/pull/" +
+          request.prNumber +
+          "#issuecomment-"
+        ).length,
+      ),
+    )
+  )
+    throw new Error("Original review exact target/request/reviewer facts are invalid");
