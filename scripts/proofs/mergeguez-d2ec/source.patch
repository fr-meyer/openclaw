--- /dev/null
+++ b/src/state/agent-run-native-retirement-custody.ts
@@ -0,0 +1,157 @@
+import { isDeepStrictEqual } from "node:util";
+import type { AdmittedRunContext } from "../agents/admitted-run-context.js";
+import type { OriginalSelectedSessionWriterCustody } from "../agents/embedded-agent-runner/run/session-bootstrap.js";
+import {
+  assertOriginalRequiredRunClosureProofForRetirement,
+  type RequiredRunClosureProof,
+} from "../agents/required-run-closure.js";
+import type { OriginalGatewayNativeCustody } from "../gateway/server-kernel.js";
+import type { SqliteWorkerAdmissionRequest } from "../infra/sqlite-worker-operation-admission.js";
+import { resolveAgentIdFromSessionKey } from "../routing/session-key.js";
+import {
+  parseAgentRunWriterRetirementRequest,
+  type AgentRunWriterRetirementRequest,
+} from "./agent-run-writer-retirement.types.js";
+import type { AgentDatabaseRequestExecutionSource } from "./openclaw-agent-execution-contract.js";
+
+export type OriginalAgentWriterRetirementBinding = Readonly<{
+  gatewayOwner: object;
+  context: AdmittedRunContext;
+  proof: RequiredRunClosureProof;
+  request: AgentRunWriterRetirementRequest;
+}>;
+type RetainedCustody = {
+  readonly source: AgentDatabaseRequestExecutionSource;
+  readonly gatewayOwner: object;
+  readonly context: AdmittedRunContext;
+  readonly proof: RequiredRunClosureProof;
+  readonly request: AgentRunWriterRetirementRequest;
+  readonly bootstrap: OriginalGatewayNativeCustody;
+  readonly physical: OriginalSelectedSessionWriterCustody;
+  readonly assertOriginalExecution: typeof import("./openclaw-agent-worker-store.js").assertOriginalRetirementSourceExecution;
+  phase: "waiting" | "transaction" | "commit" | "closed";
+};
+const sourceCustody = new WeakMap<AgentDatabaseRequestExecutionSource, RetainedCustody>();
+const proofCustody = new WeakMap<object, RetainedCustody>();
+
+function assertRetained(custody: RetainedCustody): void {
+  if (
+    sourceCustody.get(custody.source) !== custody ||
+    proofCustody.get(custody.proof) !== custody ||
+    custody.phase === "closed"
+  )
+    throw new Error("Original retirement source custody is closed or replaced");
+  custody.source.assertCurrent();
+  custody.physical.assertCurrent();
+  custody.assertOriginalExecution(custody.source, custody.physical);
+  custody.bootstrap.assertCurrent();
+  if (
+    custody.request.gatewayInstanceId !== custody.bootstrap.gatewayInstanceId ||
+    custody.request.lifecycleGeneration !== custody.bootstrap.lifecycleGeneration ||
+    !custody.bootstrap.sourceBuildSha256 ||
+    custody.bootstrap.sourceBuildScope !== "core-dist-javascript/v1" ||
+    custody.request.sourceBuildSha256 !== custody.bootstrap.sourceBuildSha256
+  )
+    throw new Error("Retirement purpose differs from its loaded Gateway generation");
+  if (
+    custody.request.runId !== custody.physical.runId ||
+    custody.request.sessionKey !== custody.physical.sessionKey ||
+    custody.request.sessionId !== custody.physical.sessionId
+  )
+    throw new Error("Retirement purpose differs from its original claimed physical writer");
+  assertOriginalRequiredRunClosureProofForRetirement(
+    custody.proof,
+    custody.context,
+    custody.request,
+    custody.gatewayOwner,
+  );
+  // The original proof validator may observe revocation; never grant from its return value.
+  custody.bootstrap.assertCurrent();
+  custody.source.assertCurrent();
+}
+
+/** Snapshot purpose before the only await; only real bootstrap and root owners can bind. */
+export async function bindOriginalAgentWriterRetirementSource(
+  source: AgentDatabaseRequestExecutionSource,
+  input: OriginalAgentWriterRetirementBinding,
+): Promise<() => void> {
+  const gatewayOwner = input.gatewayOwner,
+    context = input.context,
+    proof = input.proof;
+  const request = parseAgentRunWriterRetirementRequest(input.request);
+  if (sourceCustody.has(source) || proofCustody.has(proof))
+    throw new Error("Original retirement source or proof is already bound");
+  source.assertCurrent();
+  assertOriginalRequiredRunClosureProofForRetirement(proof, context, request, gatewayOwner);
+  // Ordinary native operations never import the Gateway graph. Retirement borrows
+  // the executing original module, whose private map rejects fabricated owners.
+  const { captureOriginalGatewayNativeCustody } = await import("../gateway/server-kernel.js");
+  const bootstrap = captureOriginalGatewayNativeCustody(gatewayOwner);
+  const { readOriginalSelectedSessionWriterCustody } =
+    await import("../agents/embedded-agent-runner/run/session-bootstrap.js");
+  const physical = readOriginalSelectedSessionWriterCustody(context);
+  const { assertOriginalRetirementSourceExecution } =
+    await import("./openclaw-agent-worker-store.js");
+  if (sourceCustody.has(source) || proofCustody.has(proof))
+    throw new Error("Original retirement source or proof was bound while acquiring bootstrap");
+  const custody: RetainedCustody = {
+    source,
+    gatewayOwner,
+    context,
+    proof,
+    request,
+    bootstrap,
+    physical,
+    assertOriginalExecution: assertOriginalRetirementSourceExecution,
+    phase: "waiting",
+  };
+  sourceCustody.set(source, custody);
+  proofCustody.set(proof, custody);
+  try {
+    assertRetained(custody);
+  } catch (failure) {
+    custody.phase = "closed";
+    throw failure;
+  }
+  return () => {
+    custody.phase = "closed";
+  };
+}
+
+/** Runs on the original host grant at transaction AND synchronous precommit. */
+export function assertOriginalAgentWriterRetirementSource(
+  source: AgentDatabaseRequestExecutionSource,
+  request: SqliteWorkerAdmissionRequest,
+  agentId: string,
+): void {
+  const custody = sourceCustody.get(source);
+  if (!custody) throw new Error("Writer retirement unavailable: original source custody is absent");
+  if (request.stage !== "transaction" && request.stage !== "commit")
+    throw new Error("Writer retirement requires native transaction and commit stages");
+  const facts = request.facts;
+  if (!facts || typeof facts !== "object" || !("publication" in facts))
+    throw new Error("Writer retirement has no original publication purpose");
+  const publication = facts.publication;
+  if (
+    !publication ||
+    typeof publication !== "object" ||
+    !("kind" in publication) ||
+    publication.kind !== "agent-run-writer-retirement" ||
+    !("request" in publication)
+  )
+    throw new Error("Writer retirement has no original publication purpose");
+  const purpose = parseAgentRunWriterRetirementRequest(publication.request);
+  if (resolveAgentIdFromSessionKey(purpose.sessionKey) !== agentId)
+    throw new Error("Original writer retirement targets a different native agent store");
+  if (!isDeepStrictEqual(purpose, custody.request))
+    throw new Error("Native writer retirement purpose changed before grant");
+  if (
+    !(
+      (custody.phase === "waiting" && request.stage === "transaction") ||
+      (custody.phase === "transaction" && request.stage === "commit")
+    )
+  )
+    throw new Error("Original writer retirement stages are out of order");
+  assertRetained(custody);
+  custody.phase = request.stage;
+}
