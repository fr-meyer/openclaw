+    const receipt: OriginalNativeReviewDispatchReceipt = Object.freeze({ kind: "original-native-review-dispatch" });
+    owner.phase = "dispatch"; owner.receipt = receipt; receipts.set(receipt, owner);
+    same(owner, original);
+    return receipt;
+  } catch (error) {
+    owner.phase = "held";
+    // Native ACK loss/source revocation is intentionally not a retryable dispatch.
+    return diagnostic(owner.request, undefined, true);
+  }
+}
+/** Only private original owner membership can authenticate a same-source dispatch receipt. */
+export function assertOriginalRequiredRunReviewDispatchReceipt(receipt: unknown, proof: OriginalNativeReviewInput["proof"], context: OriginalNativeReviewInput["context"], gatewayOwner: object): Readonly<{ requestDigest: string; intentDigest: string; status: "dispatch_unknown_held" }> {
+  if (!receipt || typeof receipt !== "object") throw new Error("Original committed review receipt unavailable");
+  const owner = receipts.get(receipt);
+  if (!owner || owner.receipt !== receipt || owners.get(proof) !== owner || (owner.phase !== "dispatch" && owner.phase !== "observed")) throw new Error("Original committed review receipt unavailable");
+  same(owner, { proof, context, gatewayOwner });
+  return Object.freeze({ requestDigest: owner.request.request.requestDigest, intentDigest: owner.request.request.intentDigest, status: "dispatch_unknown_held" });
+}
+/** Diagnostics may borrow the same original database but cannot reserve, consume or mint. */
+export async function readOriginalRequiredRunReviewIntent(input: OriginalNativeReviewInput): Promise<OriginalNativeReviewHeldObservation> {
+  const original = originalInput(input), existing = owners.get(original.proof);
+  if (existing) { same(existing, original); const result = await existing.store.reviewIntent(original, existing.request, "read"); same(existing, original); return diagnostic(existing.request, result); }
+  const owner = await open(original);
+  try { const result = await owner.store.reviewIntent(original, owner.request, "read"); owner.assertCurrent(); return diagnostic(owner.request, result); }
+  finally { owner.phase = "closed"; await owner.store.close(); }
+}
+/** Original consumer calls only after exact remote review reconciliation; no resend permission. */
+export async function observeOriginalRequiredRunReviewPublication(input: OriginalNativeReviewInput & { reviewId: number; originalObservation: unknown }): Promise<OriginalNativeReviewHeldObservation> {
+  const original = originalInput(input), owner = owners.get(original.proof);
+  if (!owner?.receipt) throw new Error("Original observation has no committed same-source dispatch receipt");
+  assertOriginalRequiredRunReviewDispatchReceipt(owner.receipt, original.proof, original.context, original.gatewayOwner);
+  const descriptor = Object.getOwnPropertyDescriptor(input, "reviewId");
+  if (!descriptor || !("value" in descriptor) || !Number.isSafeInteger(descriptor.value) || descriptor.value <= 0) throw new Error("Original review observation ID invalid");
+  const observation = Object.getOwnPropertyDescriptor(input, "originalObservation");
+  if (!observation || !("value" in observation)) throw new Error("Original remote observation missing");
+  const { assertOriginalRequiredRunReviewRemoteObservation } = await import("../gateway/github-required-review-publication.js");
+  const observed = assertOriginalRequiredRunReviewRemoteObservation(observation.value, original.proof, original.context, original.gatewayOwner);
+  if (observed.reviewId !== descriptor.value || observed.requestDigest !== owner.request.request.requestDigest || observed.intentDigest !== owner.request.request.intentDigest) throw new Error("Original remote observation differs");
+  assertOriginalRequiredRunReviewDispatchReceipt(owner.receipt, original.proof, original.context, original.gatewayOwner);
+  try {
+    const result = await owner.store.reviewIntent(original, owner.request, "observe", descriptor.value, observation.value);
+    same(owner, original);
+    if (result?.status === "observed_held") owner.phase = "observed";
+    return diagnostic(owner.request, result, !result);
+  } catch { return diagnostic(owner.request, undefined, true); }
+}
+/** Existing root finish joins cleanup after publication, before source/admission release. */
+export async function closeOriginalRequiredRunReviewPublication(input: OriginalNativeReviewInput): Promise<void> {
+  const original = originalInput(input), owner = owners.get(original.proof);
+  if (!owner || owner.original.context !== original.context || owner.original.gatewayOwner !== original.gatewayOwner) return;
+  owner.phase = "closed";
+  await owner.store.close(); // Holds remain canonical; closing never deletes/retries them.
+}
