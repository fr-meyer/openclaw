+++ b/test/scripts/agent-database-worker-package-paths.test.ts
@@ -0,0 +1,38 @@
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { transform } from "esbuild";
+import { describe, expect, it } from "vitest";
+import { collectPackageDistImportErrors, collectPackageDistImports } from "../../scripts/lib/package-dist-imports.mjs";
+import { createRuntimeProcessBuildEntries, runtimeProcessCoreEntrypoints } from "../../scripts/lib/runtime-process-core-build-entries.mts";
+import { runtimeProcessEntrypoints } from "../../src/infra/runtime-process-entrypoints.js";
+
+const worker = runtimeProcessEntrypoints.agentDatabaseExecution;
+const emittedWorker = `dist/${worker.distWorkerPath}`;
+const callers = [
+  "src/state/openclaw-agent-worker-store.ts",
+  "src/state/native-review-publication-intents.ts",
+];
+
+describe("agent database worker package paths", () => {
+  it("emits the existing agent database worker at its shared runtime path", () => {
+    const entries = createRuntimeProcessBuildEntries(runtimeProcessCoreEntrypoints);
+    expect(entries[worker.distWorkerPath.replace(/\.js$/u, "")]).toBe(
+      fileURLToPath(new URL("../../src/state/openclaw-agent-execution.worker.ts", import.meta.url)),
+    );
+  });
+
+  it.each(callers)("keeps %s worker URLs in the emitted package", async (caller) => {
+    const source = readFileSync(new URL(`../../${caller}`, import.meta.url), "utf8");
+    const { code } = await transform(source, { loader: "ts", format: "esm" });
+    // Other module imports belong to the full tarball gate. This focused check
+    // covers the worker URLs which formerly moved with bundled caller chunks.
+    for (const importerPath of ["dist/agent-database-caller.mjs", "dist/worker/worker.mjs"]) {
+      const files = [importerPath, emittedWorker];
+      const imports = collectPackageDistImports({
+        files: [importerPath],
+        readText: () => code,
+      }).filter((edge) => edge.importedPath.endsWith("openclaw-agent-execution.worker.js"));
+      expect(collectPackageDistImportErrors({ files, imports })).toEqual([]);
+    }
+  });
+});
