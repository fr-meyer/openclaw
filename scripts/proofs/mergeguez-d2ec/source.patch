@@ -0,0 +1,150 @@
+import { isDeepStrictEqual } from "node:util";
+import { isProxy } from "node:util/types";
+import { assertOriginalRequiredRunReviewIntentPurpose, readOriginalRequiredRunReviewIntentCustody } from "../agents/required-run-closure.js";
+import { readOriginalSelectedReviewPublicationDatabase } from "../agents/embedded-agent-runner/run/session-bootstrap.js";
+import { captureOpenClawAgentDatabaseExecution, type OpenClawAgentDatabaseExecution } from "./openclaw-agent-execution.js";
+import { openOpenClawAgentSqliteWorkerStore } from "./openclaw-agent-worker-store.js";
+import { parseNativeReviewIntentRequest, type NativeReviewIntentRequest, type NativeReviewIntentResult } from "./native-review-publication-intent.types.js";
+import type { OriginalNativeReviewInput } from "./native-review-publication-purpose.js";
+
+type Store = Awaited<ReturnType<typeof openOpenClawAgentSqliteWorkerStore>>;
+export type OriginalNativeReviewDispatchReceipt = Readonly<{ kind: "original-native-review-dispatch" }>;
+export type OriginalNativeReviewHeldObservation = Readonly<{ kind: "native-review-held-diagnostic"; intentDigest: string; requestDigest: string; status: "unverified_held" | "absent" | NativeReviewIntentResult["status"]; reviewId?: number }>;
+type Owner = {
+  original: OriginalNativeReviewInput; request: NativeReviewIntentRequest; assertCurrent(): void;
+  execution: OpenClawAgentDatabaseExecution; store: Store; phase: "opening" | "held" | "dispatch" | "observed" | "closed";
+  receipt?: OriginalNativeReviewDispatchReceipt;
+};
+const owners = new WeakMap<object, Owner>();
+const attempts = new WeakSet<object>();
+const receipts = new WeakMap<object, Owner>();
+function originalInput(input: OriginalNativeReviewInput): OriginalNativeReviewInput {
+  if (!input || typeof input !== "object" || isProxy(input)) throw new Error("Original review binding requires ordinary source references");
+  const descriptors = Object.getOwnPropertyDescriptors(input);
+  const { proof, context, gatewayOwner } = descriptors;
+  if (
+    !proof || !("value" in proof) || !proof.value || typeof proof.value !== "object" ||
+    !context || !("value" in context) || !context.value || typeof context.value !== "object" ||
+    !gatewayOwner || !("value" in gatewayOwner) || !gatewayOwner.value || typeof gatewayOwner.value !== "object"
+  ) throw new Error("Original review binding changed to an accessor or invalid source");
+  return Object.freeze({ proof: proof.value, context: context.value, gatewayOwner: gatewayOwner.value });
+}
+function same(owner: Owner, original: OriginalNativeReviewInput): void {
+  if (owner.original.proof !== original.proof || owner.original.context !== original.context || owner.original.gatewayOwner !== original.gatewayOwner) throw new Error("Original review owner identity differs");
+  if (owner.phase === "closed") throw new Error("Original review publication borrow is closed");
+  owner.assertCurrent();
+}
+function diagnostic(request: NativeReviewIntentRequest, result?: NativeReviewIntentResult, unknown = false): OriginalNativeReviewHeldObservation {
+  return Object.freeze({ kind: "native-review-held-diagnostic", intentDigest: request.request.intentDigest, requestDigest: request.request.requestDigest,
+    status: unknown ? "unverified_held" : result?.status ?? "absent", ...(result?.reviewId === undefined ? {} : { reviewId: result.reviewId }) });
+}
+async function open(original: OriginalNativeReviewInput): Promise<Owner> {
+  const facts = readOriginalRequiredRunReviewIntentCustody(original.proof, original.context, original.gatewayOwner);
+  const physical = readOriginalSelectedReviewPublicationDatabase(original.context);
+  const { captureOriginalGatewayNativeCustody } = await import("../gateway/server-kernel.js");
+  const bootstrap = captureOriginalGatewayNativeCustody(original.gatewayOwner);
+  const request = parseNativeReviewIntentRequest({ ...facts, gatewayInstanceId: bootstrap.gatewayInstanceId, lifecycleGeneration: bootstrap.lifecycleGeneration, sourceBuildSha256: bootstrap.sourceBuildSha256 });
+  const assertPurpose = () => {
+    physical.assertCurrent(); bootstrap.assertCurrent();
+    assertOriginalRequiredRunReviewIntentPurpose(original.proof, original.context, original.gatewayOwner, request.request);
+    const current = readOriginalRequiredRunReviewIntentCustody(original.proof, original.context, original.gatewayOwner);
+    if (current.agentId !== request.agentId || current.runId !== request.runId || current.instanceId !== request.instanceId || current.sessionKey !== request.sessionKey || current.sessionId !== request.sessionId ||
+        physical.agentId !== request.agentId || physical.runId !== request.runId || physical.sessionKey !== request.sessionKey || physical.sessionId !== request.sessionId ||
+        bootstrap.gatewayInstanceId !== request.gatewayInstanceId || bootstrap.lifecycleGeneration !== request.lifecycleGeneration || bootstrap.sourceBuildSha256 !== request.sourceBuildSha256 || bootstrap.sourceBuildScope !== "core-dist-javascript/v1") throw new Error("Original publication purpose/source generation changed");
