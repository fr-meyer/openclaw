@@ -0,0 +1,27 @@
+/** Revocation evidence never represents execution, provider or cleanup settlement. */
+export type AgentRunQuarantineTarget = Readonly<{
+  sessionKey: string;
+  sessionId: string;
+  runId: string;
+  /** null means the legacy field was absent, not an invented generation. */
+  lifecycleRevision: string | null;
+}>;
+
+export type AgentRunQuarantineRequest = Readonly<{
+  requestId: string;
+  targets: readonly AgentRunQuarantineTarget[];
+}>;
+
+export type AgentRunQuarantineReceipt = AgentRunQuarantineTarget &
+  Readonly<{
+    kind: "agent-run-quarantined";
+    quarantineId: string;
+    requestId: string;
+    committedAt: number;
+    entrySha256: string;
+    executionDrain: "unknown";
+    providerDrain: "unknown";
+    localCleanup: "unknown";
+    historicalRetirement: "unknown";
+    notAnAdmissionReceipt: true;
+  }>;
diff --git a/src/state/agent-run-recovery-intents.kernel.ts b/src/state/agent-run-recovery-intents.kernel.ts
new file mode 100644
index 00000000..d2482613
--- /dev/null
+++ b/src/state/agent-run-recovery-intents.kernel.ts
@@ -0,0 +1,410 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import { sql, type RawBuilder } from "kysely";
+import {
+  executeSqliteQuerySync,
+  executeSqliteQueryTakeFirstSync,
+  getNodeSqliteKysely,
+} from "../infra/kysely-sync.js";
+import { quarantineAgentRunsInTransaction } from "./agent-run-quarantine.kernel.js";
+import type { AgentRunQuarantineRequest } from "./agent-run-quarantine.types.js";
+
+type Intent = {
+  run_id: string;
+  session_key: string;
+  session_id: string;
+  lifecycle_revision: string | null;
+  request_id: string;
+  intent_id: string;
+  created_at: number;
+  entry_sha256: string;
+  state: "pending" | "quarantined";
+};
+type RecoveryDatabase = {
+  agent_run_recovery_intents: Intent;
+  session_nodes: { session_key: string; current_session_id: string; entry_json: string };
+};
+export type AgentRunRecoverySnapshot = {
+  readonly kind: "native-agent-recovery-holds";
+  readonly complete: true;
+  readonly expectedEntries: number;
+  readonly records: readonly {
+    runId: string;
+    sessionKey: string;
+    sessionId: string;
+    kind: string;
+  }[];
+  readonly executionDrain: "unknown";
+  readonly providerDrain: "unknown";
+  readonly localCleanup: "unknown";
+  readonly notAnAdmissionReceipt: true;
+};
+export type AgentRunRecoveryRecord = AgentRunRecoverySnapshot["records"][number];
+export type AgentRunRecoveryPage = {
+  readonly kind: "native-agent-recovery-page";
+  readonly snapshotId: string;
+  readonly offset: number;
+  readonly expectedEntries: number;
+  readonly records: readonly AgentRunRecoveryRecord[];
+  /** Only the owning traversal's final receipt establishes completeness. */
+  readonly complete: false;
+};
+export type AgentRunRecoveryTraversal = Omit<AgentRunRecoverySnapshot, "records"> & {
+  readonly snapshotId: string;
+  readonly pages: number;
+};
+function executeNativeRaw<Row>(database: DatabaseSync, query: RawBuilder<Row>) {
+  const db = getNodeSqliteKysely(database);
+  return executeSqliteQuerySync(database, { compile: () => query.compile(db) });
+}
+function inTransaction(database: DatabaseSync) {
+  if (!database.isTransaction)
+    throw new Error("Recovery intent requires the original owning transaction");
+}
+function validate(input: AgentRunQuarantineRequest) {
+  if (
+    typeof input.requestId !== "string" ||
+    !input.requestId.trim() ||
+    !Array.isArray(input.targets) ||
+    !input.targets.length ||
+    input.targets.length > 32
+  )
+    throw new Error("Recovery intent requires a bounded exact request");
+  const runs = new Set<string>();
+  for (const t of input.targets) {
+    for (const v of [t.runId, t.sessionId, t.sessionKey])
+      if (typeof v !== "string" || !v || v.trim() !== v || v.includes("\0"))
+        throw new Error("Recovery intent requires an exact identity");
+    if (
+      t.lifecycleRevision !== null &&
+      (typeof t.lifecycleRevision !== "string" || !t.lifecycleRevision.trim())
+    )
+      throw new Error("Recovery intent revision must be exact or proven absent");
+    if (runs.has(t.runId)) throw new Error("Duplicate recovery target");
+    runs.add(t.runId);
+  }
+}
+function readIntent(database: DatabaseSync, runId: string) {
+  const db = getNodeSqliteKysely<RecoveryDatabase>(database);
+  return executeSqliteQueryTakeFirstSync(
+    database,
+    db.selectFrom("agent_run_recovery_intents").selectAll().where("run_id", "=", runId),
+  );
+}
+function matches(row: Intent, t: AgentRunQuarantineRequest["targets"][number]) {
+  return (
+    row.session_key === t.sessionKey &&
+    row.session_id === t.sessionId &&
+    row.lifecycle_revision === t.lifecycleRevision
+  );
+}
+/** Reserve in its own native transaction before any later quarantine attempt. */
+export function reserveAgentRunRecoveryIntentsInTransaction(
+  database: DatabaseSync,
+  input: AgentRunQuarantineRequest,
+) {
+  inTransaction(database);
+  validate(input);
+  const db = getNodeSqliteKysely<RecoveryDatabase>(database);
+  const result: Intent[] = [];
+  for (const t of input.targets) {
+    const existing = readIntent(database, t.runId);
+    if (existing) {
+      if (!matches(existing, t))
+        throw new Error("Recovery intent conflicts with retained ownership");
+      result.push(existing);
+      continue;
+    }
+    const node = executeSqliteQueryTakeFirstSync(
+      database,
+      db
+        .selectFrom("session_nodes")
+        .selectAll()
+        .where("session_key", "=", t.sessionKey)
+        .where("current_session_id", "=", t.sessionId)
+        .where(
+          sql<boolean>`json_valid(entry_json) AND NOT EXISTS (SELECT 1 FROM json_each(entry_json) WHERE key IN ('sessionId','lifecycleRevision','activeWriterRunId') GROUP BY key HAVING count(*)>1)`,
+        ),
+    );
+    if (!node) throw new Error("Recovery target is missing, rebound or ambiguous");
+    const entry = JSON.parse(node.entry_json) as Record<string, unknown>;
+    if (
+      entry.sessionId !== t.sessionId ||
+      entry.activeWriterRunId !== t.runId ||
+      (t.lifecycleRevision === null
+        ? Object.hasOwn(entry, "lifecycleRevision")
+        : entry.lifecycleRevision !== t.lifecycleRevision)
+    )
+      throw new Error("Recovery target identity changed before intent commit");
+    const row: Intent = {
+      run_id: t.runId,
+      session_key: t.sessionKey,
+      session_id: t.sessionId,
+      lifecycle_revision: t.lifecycleRevision,
+      request_id: input.requestId,
+      intent_id: randomUUID(),
+      created_at: Date.now(),
+      entry_sha256: createHash("sha256").update(node.entry_json).digest("hex"),
+      state: "pending",
+    };
+    executeSqliteQuerySync(database, db.insertInto("agent_run_recovery_intents").values(row));
+    result.push(row);
+  }
+  return result;
+}
+/** Only the original worker operation combines immutable intent and native revocation. */
+export function commitAgentRunRecoveryQuarantinesInTransaction(
+  database: DatabaseSync,
+  input: AgentRunQuarantineRequest,
+) {
+  inTransaction(database);
+  validate(input);
+  const db = getNodeSqliteKysely<RecoveryDatabase>(database);
+  for (const t of input.targets) {
+    const row = readIntent(database, t.runId);
+    if (!row || !matches(row, t))
+      throw new Error("Quarantine lacks its prior durable recovery intent");
+  }
+  const receipts = quarantineAgentRunsInTransaction(database, input);
+  for (const t of input.targets) {
+    const row = readIntent(database, t.runId);
+    if (row?.state === "pending")
+      executeSqliteQuerySync(
+        database,
+        db
+          .updateTable("agent_run_recovery_intents")
+          .set({ state: "quarantined" })
+          .where("run_id", "=", t.runId)
+          .where("state", "=", "pending"),
+      );
+  }
+  return receipts;
+}
+// kysely-allow-raw: fixed owner tables form one immutable denial projection.
+const recoveryHolds = sql`
+  SELECT 'recovery-'||state AS kind,run_id,session_key,session_id FROM agent_run_recovery_intents
+  UNION ALL SELECT 'writer-unknown',w.run_id,w.session_key,w.session_id FROM agent_run_writer_intents w
+    WHERE NOT EXISTS (SELECT 1 FROM agent_run_writer_retirements r WHERE r.run_id=w.run_id)
+  UNION ALL SELECT 'writer-retired',run_id,session_key,session_id FROM agent_run_writer_retirements
+  UNION ALL SELECT 'quarantined',run_id,session_key,session_id FROM agent_run_quarantines
+`;
+type RecoveryRow = {
+  kind: string;
+  run_id: string;
+  session_key: string;
+  session_id: string;
+};
+const recoveryKinds = new Set([
+  "recovery-pending",
+  "recovery-quarantined",
+  "writer-unknown",
+  "writer-retired",
+  "quarantined",
+]);
+function recoveryRecords(rows: readonly RecoveryRow[]): readonly AgentRunRecoveryRecord[] {
+  return Object.freeze(
+    rows.map((r) => {
+      if (!r.run_id || !r.session_key || !r.session_id)
+        throw new Error("Native recovery snapshot has an ambiguous identity");
+      if (!recoveryKinds.has(r.kind))
+        throw new Error("Native recovery snapshot has an unknown denial kind");
+      return Object.freeze({
+        kind: r.kind,
+        runId: r.run_id,
+        sessionKey: r.session_key,
+        sessionId: r.session_id,
+      });
+    }),
+  );
+}
+function recoveryCount(database: DatabaseSync): number {
+  // kysely-allow-raw: the count and pages share the original owner's SQLite snapshot.
+  const rows = executeNativeRaw(
+    database,
+    sql<{ total: number }>`
+    WITH holds AS (${recoveryHolds}) SELECT count(*) AS total FROM holds
+  `,
+  ).rows;
+  const total = rows[0]?.total;
+  if (rows.length !== 1 || typeof total !== "number" || !Number.isSafeInteger(total) || total < 0)
+    throw new Error("Native recovery snapshot count is unavailable; admission remains held");
+  return total;
+}
+
+/**
+ * Traverse bounded keyset pages in one native snapshot. There is no resumable
+ * external cursor: a replacement connection cannot continue an earlier scan.
+ * The original startup/worker owner alone calls this synchronous primitive.
+ */
+export function visitAgentRunRecoverySnapshotInDatabase(
+  database: DatabaseSync,
+  onPage: (page: AgentRunRecoveryPage) => void,
+): AgentRunRecoveryTraversal {
+  const snapshotId = randomUUID();
+  // The public page correlation ID cannot recreate this private native scope.
+  const savepoint = `agent_recovery_${randomUUID().replaceAll("-", "")}`;
+  const location = database.location();
+  // Registry denial can notify retained observers. Those observers must not
+  // change this connection's snapshot while pages are being published.
+  // kysely-allow-raw: engine read-only scope, preserving the prior setting.
+  const previousQueryOnly = database.prepare("PRAGMA query_only").get()?.query_only;
+  if (previousQueryOnly !== 0 && previousQueryOnly !== 1)
+    throw new Error("Native recovery read-only scope is unavailable");
+  database.exec("PRAGMA query_only=ON");
+  // SAVEPOINT preserves an existing owning transaction, or starts this read
+  // snapshot. RELEASE also detects a callback that ended/replaced the owner.
+  // kysely-allow-raw: SQLite snapshot/savepoint primitive with a generated name.
+  try {
+    database.exec(`SAVEPOINT ${savepoint}`);
+  } catch (error) {
+    database.exec(`PRAGMA query_only=${previousQueryOnly}`);
+    throw error;
+  }
+  let settledOriginalSnapshot = false;
+  try {
+    const total = recoveryCount(database);
+    let offset = 0,
+      pages = 0;
+    let cursor: RecoveryRow | undefined;
+    for (;;) {
+      if (!database.isOpen || !database.isTransaction || database.location() !== location)
+        throw new Error("Native recovery snapshot owner changed; admission remains held");
+      const after = cursor
+        ? sql`WHERE (kind,run_id,session_key,session_id) > (${cursor.kind},${cursor.run_id},${cursor.session_key},${cursor.session_id})`
+        : sql``;
+      // kysely-allow-raw: fixed native projection, bound keyset and bounded page.
+      const rows = executeNativeRaw(
+        database,
+        sql<RecoveryRow>`
+        WITH holds AS (${recoveryHolds})
+        SELECT kind,run_id,session_key,session_id FROM holds ${after}
+        ORDER BY kind,run_id,session_key,session_id LIMIT 256
+      `,
+      ).rows;
+      if (!rows.length) break;
+      if (offset + rows.length > total)
+        throw new Error("Native recovery snapshot changed; admission remains held");
+      const result: unknown = onPage(
+        Object.freeze({
+          kind: "native-agent-recovery-page",
+          snapshotId,
+          offset,
+          expectedEntries: total,
+          records: recoveryRecords(rows),
+          complete: false,
+        }),
+      );
+      if (result !== undefined)
+        throw new Error("Native recovery page publication must be synchronous");
+      offset += rows.length;
+      pages++;
+      cursor = rows.at(-1);
+    }
+    // A short page never establishes completeness. Count/footer verification
+    // remains in this same snapshot, followed by successful owning RELEASE.
+    if (offset !== total || recoveryCount(database) !== total)
+      throw new Error("Native recovery snapshot incomplete; admission remains held");
+    database.exec(`RELEASE ${savepoint}`);
+    settledOriginalSnapshot = true;
+    database.exec(`PRAGMA query_only=${previousQueryOnly}`);
+    return Object.freeze({
+      kind: "native-agent-recovery-holds",
+      complete: true,
+      expectedEntries: total,
+      snapshotId,
+      pages,
+      executionDrain: "unknown",
+      providerDrain: "unknown",
+      localCleanup: "unknown",
+      notAnAdmissionReceipt: true,
+    });
+  } catch (error) {
+    if (database.isOpen) {
+      try {
+        database.exec(`ROLLBACK TO ${savepoint}; RELEASE ${savepoint}`);
+        settledOriginalSnapshot = true;
+      } catch {
+        // An ended/replaced transaction cannot certify this traversal.
+      }
+    }
+    // If ownership was ended/replaced, leave the old read-only fence in place.
+    // No stale traversal may relax the state of a successor transaction.
+    if (settledOriginalSnapshot && database.isOpen)
+      database.exec(`PRAGMA query_only=${previousQueryOnly}`);
+    throw error;
+  }
+}
+
+/** Original worker response; transport overflow refuses, never becomes clear. */
+export function readAgentRunRecoverySnapshotInDatabase(
+  database: DatabaseSync,
+): AgentRunRecoverySnapshot {
+  const records: AgentRunRecoveryRecord[] = [];
+  const receipt = visitAgentRunRecoverySnapshotInDatabase(database, (page) => {
+    records.push(...page.records);
+  });
+  return Object.freeze({
+    ...receipt,
+    records: Object.freeze(records),
+  });
+}
+
+/** Exact native rows own orphan decisions; no catalog scan or projection grants clear. */
+export function readAgentRunRecoveryHoldsForRunIdsInDatabase(
+  database: DatabaseSync,
+  runIds: readonly string[],
+): readonly AgentRunRecoveryRecord[] {
+  if (
+    !Array.isArray(runIds) ||
+    runIds.length > 32 ||
+    runIds.some((id) => typeof id !== "string" || !id || id.trim() !== id || id.includes("\0"))
+  )
+    throw new Error("Native recovery lookup requires bounded exact run IDs");
+  const captured = Object.freeze([...new Set(runIds)]);
+  if (!captured.length) return Object.freeze([]);
+  // kysely-allow-raw: fixed owner projection with a bounded exact-key predicate.
+  const rows = executeNativeRaw(
+    database,
+    sql<RecoveryRow>`
+    WITH holds AS (${recoveryHolds})
+    SELECT kind,run_id,session_key,session_id FROM holds
+    WHERE run_id IN (${sql.join(captured)}) ORDER BY kind,run_id
+  `,
+  ).rows;
+  return recoveryRecords(rows);
+}
+/** Original schema owner calls once inside the versioned migration transaction. */
+export function backfillAgentRunWriterIntentsInTransaction(database: DatabaseSync) {
+  inTransaction(database);
+  // A historical row cannot offer two interpretations of the canonical writer.
+  // Check keys before insertion; distinct values would otherwise each pass the
+  // later per-run grouping and falsely certify the migration as unambiguous.
+  // kysely-allow-raw: fixed canonical table and key; no caller SQL fragments.
+  const ambiguous = executeNativeRaw(
+    database,
+    sql<{ n: number }>`SELECT count(*) AS n FROM session_nodes n
+ WHERE EXISTS (SELECT 1
+ FROM json_each(CASE WHEN json_valid(n.entry_json) THEN n.entry_json ELSE '{}' END) j
+ WHERE j.key='activeWriterRunId' GROUP BY j.key HAVING count(*)>1)`,
+  ).rows[0];
+  if (ambiguous?.n)
+    throw new Error("Historical writer intent is ambiguous; migration remains held");
+  // kysely-allow-raw: canonical owner data is observed, not converted into terminal evidence.
+  executeNativeRaw(
+    database,
+    sql`INSERT INTO agent_run_writer_intents(run_id,session_key,session_id,created_at,evidence_kind)
+ SELECT j.value,n.session_key,n.current_session_id,n.updated_at,'native-writer-persisted'
+ FROM session_nodes n,json_each(CASE WHEN json_valid(n.entry_json) THEN n.entry_json ELSE '{}' END) j
+ WHERE j.key='activeWriterRunId' AND j.type='text' AND length(j.value)>0
+ AND NOT EXISTS(SELECT 1 FROM agent_run_writer_intents w WHERE w.run_id=j.value)
+ GROUP BY j.value HAVING count(*)=1`,
+  );
+  // Multiple canonical targets or duplicate writer keys must not be silently omitted.
+  const missing = executeNativeRaw(
+    database,
+    sql<{
+      n: number;
+    }>`SELECT count(*) AS n FROM session_nodes n,json_each(CASE WHEN json_valid(n.entry_json) THEN n.entry_json ELSE '{}' END) j WHERE j.key='activeWriterRunId' AND j.type='text' AND length(j.value)>0 AND NOT EXISTS(SELECT 1 FROM agent_run_writer_intents w WHERE w.run_id=j.value)`,
+  ).rows[0];
+  if (missing?.n) throw new Error("Historical writer intent is ambiguous; migration remains held");
+}
diff --git a/src/state/agent-run-writer-retirement.kernel.ts b/src/state/agent-run-writer-retirement.kernel.ts
new file mode 100644
index 00000000..fb7a9326
--- /dev/null
+++ b/src/state/agent-run-writer-retirement.kernel.ts
@@ -0,0 +1,214 @@
+import { createHash } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import { sql } from "kysely";
+import {
+  executeSqliteQuerySync,
+  executeSqliteQueryTakeFirstSync,
+  getNodeSqliteKysely,
+} from "../infra/kysely-sync.js";
+import {
+  parseAgentRunWriterRetirementRequest,
+  type AgentRunWriterRetirementRequest,
+  type AgentRunWriterRetirementReceipt,
+} from "./agent-run-writer-retirement.types.js";
+
+type Retired = {
+  run_id: string;
+  session_key: string;
+  session_id: string;
+  writer_created_at: number;
+  operational_instance_id: string;
+  gateway_instance_id: string;
+  lifecycle_generation: string;
+  source_build_sha256: string;
+  completion_id: string;
+  terminal_evidence_sha256: string;
+  request_sha256: string;
+  committed_at: number;
+};
+type RetirementDatabase = {
+  agent_run_writer_intents: {
+    run_id: string;
+    session_key: string;
+    session_id: string;
+    created_at: number;
+    evidence_kind: string;
+  };
+  agent_run_writer_retirements: Retired;
+};
+
+// This guard scopes one synchronous native INSERT. It is not a closure cache,
+// authority registry, event store, or substitute for the original terminal owner.
+const nativeInsertGuards = new WeakMap<
+  DatabaseSync,
+  { requestSha256?: string; committedAt?: number }
+>();
+function nativeInsertGuard(database: DatabaseSync) {
+  let guard = nativeInsertGuards.get(database);
+  if (!guard) {
+    guard = {};
+    const exact = guard;
+    database.function(
+      "native_agent_writer_retirement_authorized",
+      (
+        runId: unknown,
+        sessionKey: unknown,
+        sessionId: unknown,
+        writerCreatedAt: unknown,
+        operationalInstanceId: unknown,
+        gatewayInstanceId: unknown,
+        lifecycleGeneration: unknown,
+        sourceBuildSha256: unknown,
+        completionId: unknown,
+        terminalEvidenceSha256: unknown,
+        requestSha256: unknown,
+        committedAt: unknown,
+      ) => {
+        if (
+          !exact.requestSha256 ||
+          requestSha256 !== exact.requestSha256 ||
+          committedAt !== exact.committedAt
+        )
+          return 0;
+        const described = parseAgentRunWriterRetirementRequest({
+          runId,
+          sessionKey,
+          sessionId,
+          writerCreatedAt,
+          operationalInstanceId,
+          gatewayInstanceId,
+          lifecycleGeneration,
+          sourceBuildSha256,
+          completionId,
+          terminalEvidenceSha256,
+        });
+        return digest(described) === exact.requestSha256 ? 1 : 0;
+      },
+    );
+    nativeInsertGuards.set(database, guard);
+  }
+  return guard;
+}
+function digest(request: AgentRunWriterRetirementRequest) {
+  return createHash("sha256").update(JSON.stringify(request)).digest("hex");
+}
+function receipt(row: Retired): AgentRunWriterRetirementReceipt {
+  const request = parseAgentRunWriterRetirementRequest({
+    runId: row.run_id,
+    sessionKey: row.session_key,
+    sessionId: row.session_id,
+    writerCreatedAt: row.writer_created_at,
+    operationalInstanceId: row.operational_instance_id,
+    gatewayInstanceId: row.gateway_instance_id,
+    lifecycleGeneration: row.lifecycle_generation,
+    sourceBuildSha256: row.source_build_sha256,
+    completionId: row.completion_id,
+    terminalEvidenceSha256: row.terminal_evidence_sha256,
+  });
+  if (digest(request) !== row.request_sha256)
+    throw new Error("Native retirement evidence differs from retained digest");
+  return Object.freeze({
+    kind: "native-agent-writer-retired",
+    request,
+    committedAt: row.committed_at,
+    requestSha256: row.request_sha256,
+    notAnAdmissionReceipt: true,
+  });
+}
+
+/** Original worker only; its private admission rechecks owned closure before COMMIT. */
+/** The existing native row supplies the first writer timestamp, never a caller DTO. */
+export function readOriginalAgentRunWriterIntent(
+  database: DatabaseSync,
+  target: Pick<AgentRunWriterRetirementRequest, "runId" | "sessionKey" | "sessionId">,
+): Readonly<{ writerCreatedAt: number }> {
+  const db = getNodeSqliteKysely<RetirementDatabase>(database);
+  const writer = executeSqliteQueryTakeFirstSync(
+    database,
+    db.selectFrom("agent_run_writer_intents").selectAll().where("run_id", "=", target.runId),
+  );
+  if (
+    !writer ||
+    writer.session_key !== target.sessionKey ||
+    writer.session_id !== target.sessionId ||
+    writer.evidence_kind !== "native-writer-persisted" ||
+    !Number.isSafeInteger(writer.created_at) ||
+    writer.created_at < 0
+  )
+    throw new Error("Original native writer intent is absent or targets another session");
+  return Object.freeze({ writerCreatedAt: writer.created_at });
+}
+
+export function retireAgentRunWriterInTransaction(
+  database: DatabaseSync,
+  input: AgentRunWriterRetirementRequest,
+  authorizeOriginalTerminal: (request: AgentRunWriterRetirementRequest) => void,
+): AgentRunWriterRetirementReceipt {
+  if (!database.isTransaction)
+    throw new Error("Writer retirement requires original native transaction");
+  const request = parseAgentRunWriterRetirementRequest(input);
+  const result: unknown = authorizeOriginalTerminal(request);
+  if (result !== undefined) {
+    if (result instanceof Promise) void result.catch(() => undefined);
+    throw new Error("Original terminal authorization must be synchronous");
+  }
+  const db = getNodeSqliteKysely<RetirementDatabase>(database);
+  const writer = executeSqliteQueryTakeFirstSync(
+    database,
+    db.selectFrom("agent_run_writer_intents").selectAll().where("run_id", "=", request.runId),
+  );
+  if (
+    !writer ||
+    writer.session_key !== request.sessionKey ||
+    writer.session_id !== request.sessionId ||
+    writer.created_at !== request.writerCreatedAt ||
+    writer.evidence_kind !== "native-writer-persisted"
+  ) {
+    throw new Error("Retirement differs from immutable first writer ownership");
+  }
+  // kysely-allow-raw: fixed native revocation view; historical uncertainty cannot be retired.
+  const revocationQuery = sql<{ run_id: string }>`
+    SELECT run_id FROM agent_run_native_revocations
+    WHERE run_id=${request.runId} OR session_key=${request.sessionKey} OR session_id=${request.sessionId}
+    LIMIT 1`;
+  const revoked = executeSqliteQueryTakeFirstSync(database, {
+    compile: () => revocationQuery.compile(db),
+  });
+  if (revoked) throw new Error("Unknown or quarantined writer cannot be retired");
+  const requestSha256 = digest(request);
+  const existing = executeSqliteQueryTakeFirstSync(
+    database,
+    db.selectFrom("agent_run_writer_retirements").selectAll().where("run_id", "=", request.runId),
+  );
+  if (existing) {
+    if (existing.request_sha256 !== requestSha256)
+      throw new Error("Writer retirement conflicts with retained terminal evidence");
+    return receipt(existing);
+  }
+  const row: Retired = {
+    run_id: request.runId,
+    session_key: request.sessionKey,
+    session_id: request.sessionId,
+    writer_created_at: request.writerCreatedAt,
+    operational_instance_id: request.operationalInstanceId,
+    gateway_instance_id: request.gatewayInstanceId,
+    lifecycle_generation: request.lifecycleGeneration,
+    source_build_sha256: request.sourceBuildSha256,
+    completion_id: request.completionId,
+    terminal_evidence_sha256: request.terminalEvidenceSha256,
+    request_sha256: requestSha256,
+    committed_at: Date.now(),
+  };
+  const guard = nativeInsertGuard(database);
+  if (guard.requestSha256)
+    throw new Error("Writer retirement cannot reenter native insert admission");
+  guard.requestSha256 = requestSha256;
+  guard.committedAt = row.committed_at;
+  try {
+    executeSqliteQuerySync(database, db.insertInto("agent_run_writer_retirements").values(row));
+  } finally {
+    guard.requestSha256 = undefined;
+    guard.committedAt = undefined;
+  }
+  return receipt(row);
+}
diff --git a/src/state/agent-run-writer-retirement.types.ts b/src/state/agent-run-writer-retirement.types.ts
new file mode 100644
index 00000000..e464245d
--- /dev/null
+++ b/src/state/agent-run-writer-retirement.types.ts
@@ -0,0 +1,79 @@
+/** Recorded description only. The original private terminal owner must authorize it. */
+export type AgentRunWriterRetirementRequest = Readonly<{
+  runId: string;
+  sessionKey: string;
+  sessionId: string;
+  writerCreatedAt: number;
+  operationalInstanceId: string;
+  gatewayInstanceId: string;
+  lifecycleGeneration: string;
+  sourceBuildSha256: string;
+  completionId: string;
+  terminalEvidenceSha256: string;
+}>;
+
+/** Storage publication closes the writer's historical observation, never grants execution. */
+export type AgentRunWriterRetirementReceipt = Readonly<{
+  kind: "native-agent-writer-retired";
+  request: AgentRunWriterRetirementRequest;
+  committedAt: number;
+  requestSha256: string;
+  notAnAdmissionReceipt: true;
+}>;
+
+function exactString(value: unknown): value is string {
+  return typeof value === "string" && !!value && value.trim() === value && !value.includes("\0");
+}
+
+/** Copy before a yield or callback. No caller alias becomes durable evidence. */
+export function parseAgentRunWriterRetirementRequest(
+  value: unknown,
+): AgentRunWriterRetirementRequest {
+  if (!value || typeof value !== "object") throw new Error("Missing writer retirement descriptor");
+  const fields = Object.getOwnPropertyDescriptors(value);
+  const own = (name: string): unknown => {
+    const field = fields[name];
+    if (!field || !("value" in field)) throw new Error("Retirement requires plain exact fields");
+    return field.value;
+  };
+  const runId = own("runId"),
+    sessionKey = own("sessionKey"),
+    sessionId = own("sessionId");
+  const operationalInstanceId = own("operationalInstanceId"),
+    gatewayInstanceId = own("gatewayInstanceId");
+  const lifecycleGeneration = own("lifecycleGeneration"),
+    sourceBuildSha256 = own("sourceBuildSha256");
+  const completionId = own("completionId"),
+    terminalEvidenceSha256 = own("terminalEvidenceSha256");
+  const writerCreatedAt = own("writerCreatedAt");
+  if (
+    !exactString(runId) ||
+    !exactString(sessionKey) ||
+    !exactString(sessionId) ||
+    !exactString(operationalInstanceId) ||
+    !exactString(gatewayInstanceId) ||
+    !exactString(lifecycleGeneration) ||
+    !exactString(completionId) ||
+    typeof sourceBuildSha256 !== "string" ||
+    !/^[a-f0-9]{64}$/.test(sourceBuildSha256) ||
+    typeof terminalEvidenceSha256 !== "string" ||
+    !/^[a-f0-9]{64}$/.test(terminalEvidenceSha256) ||
+    typeof writerCreatedAt !== "number" ||
+    !Number.isSafeInteger(writerCreatedAt) ||
+    writerCreatedAt < 0
+  ) {
+    throw new Error("Writer retirement requires exact original ownership and source evidence");
+  }
+  return Object.freeze({
+    runId,
+    sessionKey,
+    sessionId,
+    writerCreatedAt,
+    operationalInstanceId,
+    gatewayInstanceId,
+    lifecycleGeneration,
+    sourceBuildSha256,
+    completionId,
+    terminalEvidenceSha256,
+  });
+}
diff --git a/src/state/native-review-publication-intent.kernel.ts b/src/state/native-review-publication-intent.kernel.ts
new file mode 100644
index 00000000..46e16d32
--- /dev/null
+++ b/src/state/native-review-publication-intent.kernel.ts
@@ -0,0 +1,109 @@
+import type { DatabaseSync } from "node:sqlite";
+import { executeSqliteQuerySync, executeSqliteQueryTakeFirstSync, getNodeSqliteKysely } from "../infra/kysely-sync.js";
+import { parseNativeReviewIntentRequest, type NativeReviewIntentRequest, type NativeReviewIntentResult, type NativeReviewIntentOperation, type NativeReviewIntentStatus } from "./native-review-publication-intent.types.js";
+
+type Row = {
+  intent_digest: string; scope_json: string; repository: string; pr_number: number;
+  head_sha: string; base_sha: string; command_comment_url: string; reviewer: string;
+  request_digest: string; ingress_digest: string; validated_output_digest: string;
+  run_id: string; instance_id: string; session_key: string; session_id: string;
+  gateway_instance_id: string; lifecycle_generation: string; source_build_sha256: string;
+  status: NativeReviewIntentStatus; review_id: number | null; created_at_ms: number; updated_at_ms: number;
+};
+type IntentDB = { native_review_publication_intents: Row };
+// SQL-trigger guard scopes one original native synchronous mutation, never source authority.
+// Original host purpose admission is mandatory before this kernel and again precommit.
+const guards = new WeakMap<DatabaseSync, { expected?: readonly unknown[] }>();
+function guarded<T>(database: DatabaseSync, operation: NativeReviewIntentOperation, row: Row, mutate: () => T): T {
+  let guard = guards.get(database);
+  if (!guard) {
+    guard = {};
+    const own = guard;
+    database.function("native_review_intent_authorized", { varargs: true }, (...values: unknown[]) => {
+      const expected = own.expected;
+      return expected && expected.length === values.length && expected.every((value, index) => value === values[index]) ? 1 : 0;
+    });
+    guards.set(database, guard);
+  }
+  if (guard.expected) throw new Error("Native review intent cannot reenter its mutation guard");
+  guard.expected = Object.freeze([operation, row.intent_digest, row.scope_json, row.status, row.review_id, row.created_at_ms, row.updated_at_ms]);
+  try { return mutate(); } finally { guard.expected = undefined; }
+}
+function scope(request: NativeReviewIntentRequest): string {
+  const value = JSON.stringify(request);
+  if (Buffer.byteLength(value, "utf8") > 8192) throw new Error("Native review intent scope exceeds bounded metadata envelope");
+  return value;
+}
+function facts(request: NativeReviewIntentRequest) {
+  return {
+    intent_digest: request.request.intentDigest, scope_json: scope(request),
+    repository: request.request.repository, pr_number: request.request.prNumber,
+    head_sha: request.request.headSha, base_sha: request.request.baseSha,
+    command_comment_url: request.request.commandCommentUrl, reviewer: request.request.reviewer,
+    request_digest: request.request.requestDigest, ingress_digest: request.request.ingressDigest,
+    validated_output_digest: request.request.validatedOutputDigest,
+    run_id: request.runId, instance_id: request.instanceId, session_key: request.sessionKey,
+    session_id: request.sessionId, gateway_instance_id: request.gatewayInstanceId,
+    lifecycle_generation: request.lifecycleGeneration, source_build_sha256: request.sourceBuildSha256,
+  };
+}
+function current(database: DatabaseSync, request: NativeReviewIntentRequest): Row | undefined {
+  const db = getNodeSqliteKysely<IntentDB>(database);
+  const row = executeSqliteQueryTakeFirstSync(database, db.selectFrom("native_review_publication_intents").selectAll().where("intent_digest", "=", request.request.intentDigest));
+  if (!row) return undefined;
+  if (typeof row.scope_json !== "string" || Buffer.byteLength(row.scope_json, "utf8") > 8192) throw new Error("Corrupt held native review intent scope");
+  const saved = parseNativeReviewIntentRequest(JSON.parse(row.scope_json));
+  const canonical = facts(saved);
+  for (const [key, value] of Object.entries(canonical)) {
+    if (row[key as keyof Row] !== value) throw new Error("Corrupt held native review intent identity");
+  }
+  if (!Number.isSafeInteger(row.created_at_ms) || !Number.isSafeInteger(row.updated_at_ms) || row.created_at_ms < 0 || row.updated_at_ms < row.created_at_ms || !["reserved_held", "dispatch_unknown_held", "observed_held"].includes(row.status) || (row.status === "observed_held") !== (row.review_id !== null) || (row.review_id !== null && (!Number.isSafeInteger(row.review_id) || row.review_id <= 0))) throw new Error("Corrupt held native review intent state");
+  if (JSON.stringify(canonical) !== JSON.stringify(facts(request))) throw new Error("Native review intent belongs to another original request/run/source");
+  return row;
+}
+function receipt(row: Row, inserted = false, consumed = false): NativeReviewIntentResult {
+  return Object.freeze({ intentDigest: row.intent_digest, requestDigest: row.request_digest, status: row.status, inserted, consumed, ...(row.review_id === null ? {} : { reviewId: row.review_id }) });
+}
+function transaction(database: DatabaseSync): void {
+  if (!database.isTransaction) throw new Error("Native review intent requires its original native transaction");
+}
+export function readNativeReviewPublicationIntent(database: DatabaseSync, input: unknown): NativeReviewIntentResult | undefined {
+  const request = parseNativeReviewIntentRequest(input), row = current(database, request);
+  return row ? receipt(row) : undefined; // Diagnostic only; cannot mint original dispatch authority.
+}
+export function reserveNativeReviewPublicationIntentInTransaction(database: DatabaseSync, input: unknown): NativeReviewIntentResult {
+  transaction(database);
+  const request = parseNativeReviewIntentRequest(input), existing = current(database, request);
+  if (existing) return receipt(existing); // Identical or observed rows never grant fresh consume permission.
+  const now = Date.now();
+  const row: Row = { ...facts(request), status: "reserved_held", review_id: null, created_at_ms: now, updated_at_ms: now };
+  const db = getNodeSqliteKysely<IntentDB>(database);
+  guarded(database, "reserve", row, () => executeSqliteQuerySync(database, db.insertInto("native_review_publication_intents").values(row)));
+  return receipt(row, true);
+}
+export function consumeNativeReviewPublicationIntentInTransaction(database: DatabaseSync, input: unknown): NativeReviewIntentResult {
+  transaction(database);
+  const request = parseNativeReviewIntentRequest(input), existing = current(database, request);
+  if (!existing) throw new Error("Native review reserve is absent");
+  if (existing.status !== "reserved_held") return receipt(existing);
+  const row: Row = { ...existing, status: "dispatch_unknown_held", updated_at_ms: Math.max(Date.now(), existing.updated_at_ms) };
+  const db = getNodeSqliteKysely<IntentDB>(database);
+  const result = guarded(database, "consume", row, () => executeSqliteQuerySync(database, db.updateTable("native_review_publication_intents").set({ status: row.status, updated_at_ms: row.updated_at_ms }).where("intent_digest", "=", row.intent_digest).where("status", "=", "reserved_held")));
+  if (result.numAffectedRows !== 1n) throw new Error("Native review intent consume CAS failed");
+  return receipt(row, false, true);
+}
+export function observeNativeReviewPublicationIntentInTransaction(database: DatabaseSync, input: unknown, reviewId: number): NativeReviewIntentResult {
+  transaction(database);
+  if (!Number.isSafeInteger(reviewId) || reviewId <= 0) throw new Error("Native review observation ID is invalid");
+  const request = parseNativeReviewIntentRequest(input), existing = current(database, request);
+  if (!existing || existing.status === "reserved_held") throw new Error("Native review observation has no consumed intent");
+  if (existing.status === "observed_held") {
+    if (existing.review_id !== reviewId) throw new Error("Native review observation conflicts with retained review ID");
+    return receipt(existing);
+  }
+  const row: Row = { ...existing, status: "observed_held", review_id: reviewId, updated_at_ms: Math.max(Date.now(), existing.updated_at_ms) };
+  const db = getNodeSqliteKysely<IntentDB>(database);
+  const result = guarded(database, "observe", row, () => executeSqliteQuerySync(database, db.updateTable("native_review_publication_intents").set({ status: row.status, review_id: reviewId, updated_at_ms: row.updated_at_ms }).where("intent_digest", "=", row.intent_digest).where("status", "=", "dispatch_unknown_held")));
+  if (result.numAffectedRows !== 1n) throw new Error("Native review observation CAS failed");
+  return receipt(row);
+}
diff --git a/src/state/native-review-publication-intent.schema.ts b/src/state/native-review-publication-intent.schema.ts
new file mode 100644
index 00000000..18c7dd44
--- /dev/null
+++ b/src/state/native-review-publication-intent.schema.ts
@@ -0,0 +1,14 @@
+/** Isolated schema26 proposal. No rollout or migration activation is implied. */
+export const NATIVE_REVIEW_PUBLICATION_INTENT_SCHEMA_VERSION = 26;
+const START = "-- BEGIN NATIVE REVIEW PUBLICATION INTENT SCHEMA\n";
+const END = "-- END NATIVE REVIEW PUBLICATION INTENT SCHEMA\n";
+export function nativeReviewPublicationIntentSchemaSql(schema: string): string {
+  const start = schema.indexOf(START), end = schema.indexOf(END, start);
+  if (start < 0 || end < 0 || schema.indexOf(START, start + START.length) >= 0 || schema.indexOf(END, end + END.length) >= 0) throw new Error("Ambiguous native review intent schema boundaries");
+  return schema.slice(start, end + END.length);
+}
+export function withoutNativeReviewPublicationIntentSchema(schema: string): string {
+  if (!schema.includes(START) && !schema.includes(END)) return schema;
+  const intent = nativeReviewPublicationIntentSchemaSql(schema);
+  return schema.replace(intent, "");
+}
diff --git a/src/state/native-review-publication-intent.types.ts b/src/state/native-review-publication-intent.types.ts
new file mode 100644
index 00000000..0aff1ff7
--- /dev/null
+++ b/src/state/native-review-publication-intent.types.ts
@@ -0,0 +1,81 @@
+import { isProxy } from "node:util/types";
+
+export type NativeReviewTarget = Readonly<{
+  repository: string; prNumber: number; headSha: string; baseSha: string;
+  commandCommentUrl: string; taskId: string; authorId: number; authorLogin: string;
+  reviewerId: number; reviewer: "mergeguez[bot]";
+  event: "APPROVE" | "REQUEST_CHANGES" | "COMMENT";
+  bodySha256: string; inlineCommentsSha256: string; inlineCommentsCount: number;
+  ingressDigest: string; validatedOutputDigest: string; requestDigest: string; intentDigest: string;
+}>;
+export type NativeReviewIntentRequest = Readonly<{
+  agentId: string; runId: string; instanceId: string; sessionKey: string; sessionId: string;
+  gatewayInstanceId: string; lifecycleGeneration: string; sourceBuildSha256: string;
+  purpose: "mergeguez-pr-review"; request: NativeReviewTarget;
+}>;
+export type NativeReviewIntentOperation = "reserve" | "consume" | "observe";
+export type NativeReviewIntentStatus = "reserved_held" | "dispatch_unknown_held" | "observed_held";
+export type NativeReviewIntentResult = Readonly<{
+  intentDigest: string; requestDigest: string; status: NativeReviewIntentStatus;
+  inserted: boolean; consumed: boolean; reviewId?: number;
+}>;
+
+const ROOT_KEYS = ["agentId", "runId", "instanceId", "sessionKey", "sessionId", "gatewayInstanceId", "lifecycleGeneration", "sourceBuildSha256", "purpose", "request"];
+const TARGET_KEYS = ["repository", "prNumber", "headSha", "baseSha", "commandCommentUrl", "taskId", "authorId", "authorLogin", "reviewerId", "reviewer", "event", "bodySha256", "inlineCommentsSha256", "inlineCommentsCount", "ingressDigest", "validatedOutputDigest", "requestDigest", "intentDigest"];
