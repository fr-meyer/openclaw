+import { createHash, randomUUID } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import { sql } from "kysely";
+import {
+  executeSqliteQuerySync,
+  executeSqliteQueryTakeFirstSync,
+  getNodeSqliteKysely,
+} from "../infra/kysely-sync.js";
+import type {
+  AgentRunQuarantineReceipt,
+  AgentRunQuarantineRequest,
+  AgentRunQuarantineTarget,
+} from "./agent-run-quarantine.types.js";
+
+type QuarantineRow = {
+  run_id: string;
+  session_key: string;
+  session_id: string;
+  lifecycle_revision: string | null;
+  quarantine_id: string;
+  request_id: string;
+  committed_at: number;
+  entry_sha256: string;
+};
+type QuarantineDatabase = {
+  agent_run_quarantines: QuarantineRow;
+  session_nodes: { session_key: string; current_session_id: string; entry_json: string };
+};
+
+function validateTarget(target: AgentRunQuarantineTarget): void {
+  for (const value of [target.sessionKey, target.sessionId, target.runId]) {
+    if (typeof value !== "string" || !value || value.trim() !== value || value.includes("\0")) {
+      throw new Error("Quarantine requires an exact nonempty identity");
+    }
+  }
+  if (
+    target.lifecycleRevision !== null &&
+    (typeof target.lifecycleRevision !== "string" || !target.lifecycleRevision.trim())
+  ) {
+    throw new Error("Quarantine requires an exact revision or proven absence");
+  }
+}
+
+function receipt(row: QuarantineRow): AgentRunQuarantineReceipt {
+  return Object.freeze({
+    kind: "agent-run-quarantined",
+    runId: row.run_id,
+    sessionKey: row.session_key,
+    sessionId: row.session_id,
+    lifecycleRevision: row.lifecycle_revision,
+    quarantineId: row.quarantine_id,
+    requestId: row.request_id,
+    committedAt: row.committed_at,
+    entrySha256: row.entry_sha256,
+    executionDrain: "unknown",
+    providerDrain: "unknown",
+    localCleanup: "unknown",
+    historicalRetirement: "unknown",
+    notAnAdmissionReceipt: true,
+  });
+}
+
+/** Existing schema admission owns table/shape facts; this never creates or opens a store. */
+export function readAgentRunQuarantinesInDatabase(
+  database: DatabaseSync,
+): AgentRunQuarantineReceipt[] {
+  const db = getNodeSqliteKysely<QuarantineDatabase>(database);
+  return executeSqliteQuerySync(
+    database,
+    db.selectFrom("agent_run_quarantines").selectAll().orderBy("run_id", "asc"),
+  ).rows.map(receipt);
+}
+
+/** Must execute inside the original agent worker's synchronous write transaction. */
+export function quarantineAgentRunsInTransaction(
+  database: DatabaseSync,
+  input: AgentRunQuarantineRequest,
+): AgentRunQuarantineReceipt[] {
+  if (!database.isTransaction) {
+    throw new Error("Quarantine requires the native owning transaction");
+  }
+  if (
+    typeof input.requestId !== "string" ||
+    !input.requestId.trim() ||
+    input.targets.length === 0 ||
+    input.targets.length > 32
+  ) {
+    throw new Error("Quarantine requires a bounded exact request");
+  }
+  const db = getNodeSqliteKysely<QuarantineDatabase>(database);
+  const runIds = new Set<string>();
+  const results: AgentRunQuarantineReceipt[] = [];
+  for (const target of input.targets) {
+    validateTarget(target);
+    if (runIds.has(target.runId)) {
+      throw new Error("Duplicate run in quarantine request");
+    }
+    runIds.add(target.runId);
+    const existing = executeSqliteQueryTakeFirstSync(
+      database,
+      db.selectFrom("agent_run_quarantines").selectAll().where("run_id", "=", target.runId),
+    );
+    if (existing) {
+      if (
+        existing.session_key !== target.sessionKey ||
+        existing.session_id !== target.sessionId ||
+        existing.lifecycle_revision !== target.lifecycleRevision
+      ) {
+        throw new Error("Quarantine identity conflicts with durable revocation");
+      }
+      results.push(receipt(existing));
+      continue;
+    }
+    const node = executeSqliteQueryTakeFirstSync(
+      database,
+      db
+        .selectFrom("session_nodes")
+        .selectAll()
+        .where("session_key", "=", target.sessionKey)
+        .where("current_session_id", "=", target.sessionId)
+        .where((eb) => eb(eb.fn("json_valid", ["entry_json"]), "=", 1))
+        // kysely-allow-raw: JSON1 rejects duplicate owner keys before JSON.parse can select the last.
+        .where(sql<boolean>`NOT EXISTS (
+          SELECT 1 FROM json_each(entry_json)
+          WHERE key IN ('sessionId', 'lifecycleRevision', 'activeWriterRunId')
+          GROUP BY key HAVING count(*) > 1
+        )`),
+    );
+    if (!node) {
+      throw new Error("Quarantine target is missing, rebound or ambiguous");
+    }
+    const entry = JSON.parse(node.entry_json) as Record<string, unknown>;
+    const revisionMatches =
+      target.lifecycleRevision === null
+        ? !Object.hasOwn(entry, "lifecycleRevision")
+        : entry.lifecycleRevision === target.lifecycleRevision;
+    if (
+      entry.sessionId !== target.sessionId ||
+      entry.activeWriterRunId !== target.runId ||
+      !revisionMatches
+    ) {
+      throw new Error("Quarantine writer identity changed before commit");
+    }
+    const row: QuarantineRow = {
+      run_id: target.runId,
+      session_key: target.sessionKey,
+      session_id: target.sessionId,
+      lifecycle_revision: target.lifecycleRevision,
+      quarantine_id: randomUUID(),
+      request_id: input.requestId,
+      committed_at: Date.now(),
+      entry_sha256: createHash("sha256").update(node.entry_json).digest("hex"),
+    };
+    executeSqliteQuerySync(database, db.insertInto("agent_run_quarantines").values(row));
+    results.push(receipt(row));
+  }
+  return results;
+}
+
+/** Early refusal; schema-owned triggers enforce the same fact at every covered commit. */
+export function assertAgentRunQuarantineAllowsWrite(
+  database: DatabaseSync,
+  target: { sessionKey?: string; sessionId?: string; runId?: string },
+): void {
+  const db = getNodeSqliteKysely<QuarantineDatabase>(database);
+  const clauses = [
+    target.sessionKey && ["session_key", target.sessionKey],
+    target.sessionId && ["session_id", target.sessionId],
+    target.runId && ["run_id", target.runId],
+  ].filter((value): value is ["session_key" | "session_id" | "run_id", string] =>
+    Array.isArray(value),
+  );
+  if (!clauses.length) {
+    throw new Error("Quarantine check requires a bound mutation identity");
+  }
+  const match = executeSqliteQueryTakeFirstSync(
+    database,
+    db
+      .selectFrom("agent_run_quarantines")
+      .select("run_id")
+      .where((eb) => eb.or(clauses.map(([key, value]) => eb(key, "=", value)))),
+  );
+  if (match) {
+    throw new Error(
+      "Agent run quarantine forbids this mutation; historical outcomes remain unknown",
+    );
+  }
+}
