+/** Snapshot data without invoking caller getters or proxy traps. */
+function ownData(value: unknown, keys: readonly string[]): Record<string, unknown> {
+  if (!value || typeof value !== "object" || Array.isArray(value) || types.isProxy(value))
+    throw new Error("Quarantine requires an own-data record");
+  const descriptors = Object.getOwnPropertyDescriptors(value);
+  if (Reflect.ownKeys(descriptors).length !== keys.length)
+    throw new Error("Quarantine record fields are absent or unexpected");
+  const result: Record<string, unknown> = Object.create(null);
+  for (const key of keys) {
+    const descriptor = Object.getOwnPropertyDescriptor(descriptors, key)?.value;
+    if (!descriptor || !Object.hasOwn(descriptor, "value"))
+      throw new Error("Quarantine record fields are absent or accessor-backed");
+    result[key] = descriptor.value;
+  }
+  return result;
+}
+
+function exactText(value: unknown): string {
+  if (typeof value !== "string" || !value || value.trim() !== value || value.includes("\0"))
+    throw new Error("Quarantine requires an exact nonempty identity");
+  return value;
+}
+
+function ownArray(value: unknown): readonly unknown[] {
+  if (!Array.isArray(value) || types.isProxy(value) || value.length < 1 || value.length > 32)
+    throw new Error("Quarantine requires a bounded nonempty array");
+  const result: unknown[] = [];
+  for (let index = 0; index < value.length; index++) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, String(index));
+    if (!descriptor || !Object.hasOwn(descriptor, "value"))
+      throw new Error("Quarantine array is sparse or accessor-backed");
+    result.push(descriptor.value);
+  }
+  return result;
+}
+
+const TARGET_KEYS = ["runId", "sessionId", "sessionKey", "lifecycleRevision"];
+function targetFromData(data: Record<string, unknown>): AgentRunQuarantineTarget {
+  const lifecycleRevision = data.lifecycleRevision === null ? null : exactText(data.lifecycleRevision);
+  return Object.freeze({
+    runId: exactText(data.runId), sessionId: exactText(data.sessionId),
+    sessionKey: exactText(data.sessionKey), lifecycleRevision,
+  });
+}
+
+/** Parsing grants no maintenance, native transaction, drain or admission authority. */
+export function parseAgentRunQuarantineRequest(value: unknown): AgentRunQuarantineRequest {
+  const data = ownData(value, ["requestId", "targets"]);
+  const requestId = exactText(data.requestId);
+  const targets = ownArray(data.targets).map((entry) => targetFromData(ownData(entry, TARGET_KEYS)));
+  if (new Set(targets.map((target) => target.runId)).size !== targets.length)
+    throw new Error("Quarantine requires distinct exact run targets");
+  return Object.freeze({ requestId, targets: Object.freeze(targets) });
+}
+
+/** Complete exact denial data, never proof of native commit or provider settlement. */
+export function parseAgentRunQuarantineReceipts(
+  value: unknown,
+  request: AgentRunQuarantineRequest,
+): readonly AgentRunQuarantineReceipt[] {
+  const rows = ownArray(value);
+  if (rows.length !== request.targets.length)
+    throw new Error("Quarantine result does not cover every exact target");
+  const remaining = new Map(request.targets.map((target) => [target.runId, target]));
+  const receipts = rows.map((entry): AgentRunQuarantineReceipt => {
+    const data = ownData(entry, [...TARGET_KEYS, "kind", "quarantineId", "requestId", "committedAt",
+      "entrySha256", "executionDrain", "providerDrain", "localCleanup", "historicalRetirement", "notAnAdmissionReceipt"]);
+    const target = targetFromData(data);
+    const expected = remaining.get(target.runId);
+    if (!expected || target.sessionKey !== expected.sessionKey || target.sessionId !== expected.sessionId ||
+        target.lifecycleRevision !== expected.lifecycleRevision)
+      throw new Error("Quarantine receipt differs from the exact requested owner");
+    remaining.delete(target.runId);
+    if (data.kind !== "agent-run-quarantined" || data.executionDrain !== "unknown" ||
+        data.providerDrain !== "unknown" || data.localCleanup !== "unknown" ||
+        data.historicalRetirement !== "unknown" || data.notAnAdmissionReceipt !== true ||
+        typeof data.committedAt !== "number" || !Number.isSafeInteger(data.committedAt) || data.committedAt < 0 ||
+        typeof data.entrySha256 !== "string" || !/^[a-f0-9]{64}$/u.test(data.entrySha256))
+      throw new Error("Quarantine receipt is incomplete or claims unsupported settlement");
+    return Object.freeze({ ...target, kind: "agent-run-quarantined", quarantineId: exactText(data.quarantineId),
+      // Idempotent readback retains its original creator; it never re-labels the fence.
+      requestId: exactText(data.requestId), committedAt: data.committedAt, entrySha256: data.entrySha256,
+      executionDrain: "unknown", providerDrain: "unknown", localCleanup: "unknown",
+      historicalRetirement: "unknown", notAnAdmissionReceipt: true });
+  });
+  return Object.freeze(receipts);
+}
