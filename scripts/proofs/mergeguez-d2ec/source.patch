+  const endpoint = "repos/" + saved.request.repository + "/pulls/" + saved.request.prNumber;
+  const assertRemote = async (requireCurrentHead: boolean) => {
+    const user = await api("user");
+    assertCurrent();
+    if (
+      !record(user) ||
+      user.type !== "Bot" ||
+      !sameLogin(user.login, REVIEWER) ||
+      !positiveAccountId(user.id) ||
+      !positiveAccountId(identity?.account.accountId) ||
+      user.id !== identity?.account.accountId ||
+      user.id !== intent.request.reviewerId
+    )
+      throw new Error("Original review account changed");
+    const pr = await api(endpoint);
+    assertCurrent();
+    if (
+      !record(pr) ||
+      !record(pr.head) ||
+      !record(pr.base) ||
+      !record(pr.user) ||
+      !positiveAccountId(pr.user.id) ||
+      !accountLogin(pr.user.login) ||
+      pr.user.id !== intent.request.authorId ||
+      !sameLogin(pr.user.login, intent.request.authorLogin) ||
+      pr.user.id === identity?.account.accountId ||
+      sameLogin(pr.user.login, REVIEWER) ||
+      !record(pr.base.repo) ||
+      pr.base.repo.full_name !== saved.request.repository
+    )
+      throw new Error("Original PR head/base/repository/author changed");
+    if (
+      requireCurrentHead &&
+      (pr.state !== "open" ||
+        pr.head.sha !== saved.request.headSha ||
+        pr.base.sha !== saved.request.baseSha)
+    )
+      throw new Error("Original PR head/base changed before publication");
+  };
+  const reconcile = async (): Promise<{ matchFound: boolean; reviewId?: number; originalObservation?: object }> => {
+    for (let page = 1; page <= MAX_PAGES; page++) {
+      const reviews = await api(endpoint + "/reviews?per_page=100&page=" + page);
+      assertCurrent();
+      if (!Array.isArray(reviews)) throw new Error("Original review reconciliation is invalid");
+      for (const review of reviews) {
+        if (!matchesReview(review, saved, identity!.account.accountId)) continue;
+        // Inline reconciliation is deliberately held until the original source
+        // owns the exact paginated comment inventory; prose alone is insufficient.
+        if (saved.wire.comments?.length) return { matchFound: true };
+        const reviewId = Number(review.id);
+        const originalObservation = Object.freeze({});
+        remoteObservations.set(originalObservation, Object.freeze({
+          proof,
+          context,
+          gatewayOwner,
+          facts: Object.freeze({ reviewId, requestDigest: saved.request.requestDigest, intentDigest: intent.request.intentDigest }),
+          assertCurrent,
+        }));
+        return { matchFound: true, reviewId, originalObservation };
+      }
+      if (reviews.length < 100) return { matchFound: false };
+    }
+    throw new Error("Original review reconciliation exceeded its bounded page limit");
+  };
+  try {
+    identity = await prepareCurrentRequiredReviewGitHubIdentity({ proof, context, gatewayOwner });
+    assertCurrent();
+    if (!sameLogin(identity.account.login, REVIEWER))
+      throw new Error("Original review requires the existing Bot credential");
+    await assertRemote(operation === "publish");
+    assertCurrent();
+    const existing = await reconcile();
+    assertCurrent();
+    if (existing.matchFound) {
+      if (existing.reviewId !== undefined && existing.originalObservation)
+        await observe(existing.reviewId, existing.originalObservation);
+      assertCurrent();
+      effect.phase = existing.reviewId === undefined ? "unknown-held" : "observed-held";
+      return held(existing.reviewId); // Even partial evidence suppresses another POST.
+    }
+    if (operation === "reconcile") return held(); // Absence never becomes dispatch permission.
+    if (effect.phase !== "preparing") return held();
+    await assertRemote(true); // Fresh target read after all preceding reconciliation awaits.
+    assertCurrent();
+    // Native consume already holds this exact intent. An absent remote readback
+    // never produces a replacement consume receipt or another POST.
+    effect.phase = "unknown-held";
+    assertCurrent();
+    await api(endpoint + "/reviews", "POST"); // Exactly one attempt; no fallback, retry or redirect.
+    assertCurrent();
+    const observed = await reconcile();
+    assertCurrent();
+    if (observed.reviewId !== undefined && observed.originalObservation) {
+      await observe(observed.reviewId, observed.originalObservation);
+      assertCurrent();
+      effect.phase = "observed-held";
+    }
+    return held(observed.reviewId);
+  } catch {
+    effect.phase = "unknown-held";
+    return held(); // A 502, malformed body, lost ACK or authority change never permits another POST.
+  }
+}
+
+export async function publishOriginalRequiredRunReview(
+  input: OriginalRequiredReviewPublicationInput,
+): Promise<OriginalRequiredReviewPublicationResult> {
+  return await runOriginalRequiredRunReview(input, "publish");
+}
+
+/** Read-only recovery never clears custody, counts partial coverage or grants a resend. */
+export async function reconcileOriginalRequiredRunReview(
+  input: OriginalRequiredReviewPublicationInput,
+): Promise<OriginalRequiredReviewPublicationResult> {
+  return await runOriginalRequiredRunReview(input, "reconcile");
+}
