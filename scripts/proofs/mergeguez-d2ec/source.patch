+/** Snapshot complete immutable purpose without evaluating caller accessors. Data is not authority. */
+export function parseNativeReviewIntentRequest(input: unknown): NativeReviewIntentRequest {
+  const original = data(input, ROOT_KEYS), target = data(original.request, TARGET_KEYS);
+  const repository = text(target.repository, 201);
+  if (!/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(repository)) throw new Error("Review repository is invalid");
