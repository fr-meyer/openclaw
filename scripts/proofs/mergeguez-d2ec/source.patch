+  const files = list(data.files, 4096).map((value) => {
+    const file = own(value, ["path", "status", "patchSha256"], ["previousPath"]), path = filepath(file.path);
+    if (seen.has(path)) throw new Error("Review file manifest has duplicate paths");
+    seen.add(path);
+    if (typeof file.status !== "string" || !["added", "modified", "removed", "renamed"].includes(file.status)) throw new Error("Review file change status is invalid");
+    const status = file.status as MergeguezReviewRequest["files"][number]["status"];
+    const previousPath = file.previousPath === undefined ? undefined : filepath(file.previousPath);
+    if ((status === "renamed") !== (previousPath !== undefined) || previousPath === path) throw new Error("Review rename manifest is incomplete");
+    return Object.freeze({ path, status, patchSha256: digest(file.patchSha256, DIGEST), ...(previousPath ? { previousPath } : {}) });
+  });
+  if (!files.length) throw new Error("Review exact file manifest is empty");
