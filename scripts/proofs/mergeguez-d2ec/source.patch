+-- Recovery intent is durable before revocation is attempted. No row is a drain receipt.
+CREATE TABLE IF NOT EXISTS agent_run_recovery_intents (
+  run_id TEXT PRIMARY KEY,
+  session_key TEXT NOT NULL,
+  session_id TEXT NOT NULL,
+  lifecycle_revision TEXT,
+  request_id TEXT NOT NULL,
+  intent_id TEXT NOT NULL UNIQUE,
+  created_at INTEGER NOT NULL,
+  entry_sha256 TEXT NOT NULL,
+  state TEXT NOT NULL CHECK(state IN ('pending','quarantined'))
+) STRICT;
+CREATE TRIGGER IF NOT EXISTS agent_run_recovery_intents_no_replace
+BEFORE INSERT ON agent_run_recovery_intents
+WHEN EXISTS(SELECT 1 FROM agent_run_recovery_intents WHERE run_id=NEW.run_id OR intent_id=NEW.intent_id)
+BEGIN SELECT RAISE(ABORT,'Recovery intent cannot be replaced'); END;
+CREATE TRIGGER IF NOT EXISTS agent_run_recovery_intents_no_delete
+BEFORE DELETE ON agent_run_recovery_intents
+BEGIN SELECT RAISE(ABORT,'Recovery intent cannot be deleted'); END;
+CREATE TRIGGER IF NOT EXISTS agent_run_recovery_intents_update_guard
+BEFORE UPDATE ON agent_run_recovery_intents
+WHEN OLD.run_id IS NOT NEW.run_id OR OLD.session_key IS NOT NEW.session_key
+ OR OLD.session_id IS NOT NEW.session_id OR OLD.lifecycle_revision IS NOT NEW.lifecycle_revision
+ OR OLD.request_id IS NOT NEW.request_id OR OLD.intent_id IS NOT NEW.intent_id
+ OR OLD.created_at IS NOT NEW.created_at OR OLD.entry_sha256 IS NOT NEW.entry_sha256
+ OR OLD.state<>'pending' OR NEW.state<>'quarantined'
+ OR NOT EXISTS(SELECT 1 FROM agent_run_quarantines q WHERE q.run_id=OLD.run_id
+   AND q.session_key=OLD.session_key AND q.session_id=OLD.session_id
+   AND q.lifecycle_revision IS OLD.lifecycle_revision)
+BEGIN SELECT RAISE(ABORT,'Recovery intent transition lacks durable native revocation'); END;
+
+-- First persisted writer ownership is evidence. It is never proof of provider start/finish.
+-- Keeping the first target allows the original compaction owner to adopt successors
+-- without rewriting prior custody. Restart must hold every unresolved native intent.
+CREATE TABLE IF NOT EXISTS agent_run_writer_intents (
+  run_id TEXT PRIMARY KEY,
+  session_key TEXT NOT NULL,
+  session_id TEXT NOT NULL,
+  created_at INTEGER NOT NULL,
+  evidence_kind TEXT NOT NULL CHECK(evidence_kind='native-writer-persisted')
+) STRICT;
+CREATE TRIGGER IF NOT EXISTS agent_run_writer_intents_no_replace
+BEFORE INSERT ON agent_run_writer_intents
+WHEN EXISTS(SELECT 1 FROM agent_run_writer_intents WHERE run_id=NEW.run_id)
+BEGIN SELECT RAISE(ABORT,'Native writer intent cannot be replaced'); END;
+CREATE TRIGGER IF NOT EXISTS agent_run_writer_intents_no_delete
+BEFORE DELETE ON agent_run_writer_intents
+BEGIN SELECT RAISE(ABORT,'Native writer intent cannot be deleted'); END;
+CREATE TRIGGER IF NOT EXISTS agent_run_writer_intents_no_update
+BEFORE UPDATE ON agent_run_writer_intents
+BEGIN SELECT RAISE(ABORT,'Native writer intent cannot be rewritten'); END;
+CREATE TRIGGER IF NOT EXISTS session_nodes_record_writer_intent_insert
+AFTER INSERT ON session_nodes WHEN json_valid(NEW.entry_json)
+BEGIN
+ INSERT INTO agent_run_writer_intents(run_id,session_key,session_id,created_at,evidence_kind)
+ SELECT DISTINCT value,NEW.session_key,NEW.current_session_id,NEW.updated_at,'native-writer-persisted'
+ FROM json_each(NEW.entry_json) j WHERE j.key='activeWriterRunId' AND j.type='text'
+ AND length(j.value)>0 AND NOT EXISTS(SELECT 1 FROM agent_run_writer_intents w WHERE w.run_id=j.value);
+END;
+CREATE TRIGGER IF NOT EXISTS session_nodes_record_writer_intent_update
+AFTER UPDATE OF entry_json ON session_nodes WHEN json_valid(NEW.entry_json)
+BEGIN
+ INSERT INTO agent_run_writer_intents(run_id,session_key,session_id,created_at,evidence_kind)
+ SELECT DISTINCT value,NEW.session_key,NEW.current_session_id,NEW.updated_at,'native-writer-persisted'
+ FROM json_each(NEW.entry_json) j WHERE j.key='activeWriterRunId' AND j.type='text'
+ AND length(j.value)>0 AND NOT EXISTS(SELECT 1 FROM agent_run_writer_intents w WHERE w.run_id=j.value);
+END;
+-- Both committed recovery intent and final quarantine revoke native writes.
+-- Writer observation alone is evidence and does not revoke ordinary active writes.
+CREATE VIEW IF NOT EXISTS agent_run_native_revocations AS
+SELECT run_id,session_key,session_id FROM agent_run_quarantines
+UNION
+SELECT run_id,session_key,session_id FROM agent_run_recovery_intents;
+-- Terminal retirement retains original writer evidence and permanently denies old IDs.
+-- These rows may be inserted only by the original worker's purpose-bound operation.
+CREATE TABLE IF NOT EXISTS agent_run_writer_retirements (
+ run_id TEXT PRIMARY KEY,
+ session_key TEXT NOT NULL,
+ session_id TEXT NOT NULL,
+ writer_created_at INTEGER NOT NULL,
+ operational_instance_id TEXT NOT NULL,
+ gateway_instance_id TEXT NOT NULL,
+ lifecycle_generation TEXT NOT NULL,
+ source_build_sha256 TEXT NOT NULL,
+ completion_id TEXT NOT NULL UNIQUE,
+ terminal_evidence_sha256 TEXT NOT NULL,
+ request_sha256 TEXT NOT NULL,
+ committed_at INTEGER NOT NULL,
+ FOREIGN KEY(run_id) REFERENCES agent_run_writer_intents(run_id)
+) STRICT;
+CREATE TRIGGER IF NOT EXISTS agent_run_writer_retirements_insert_guard
+BEFORE INSERT ON agent_run_writer_retirements
+WHEN native_agent_writer_retirement_authorized(NEW.run_id,NEW.session_key,NEW.session_id,
+ NEW.writer_created_at,NEW.operational_instance_id,NEW.gateway_instance_id,NEW.lifecycle_generation,
+ NEW.source_build_sha256,NEW.completion_id,NEW.terminal_evidence_sha256,NEW.request_sha256,NEW.committed_at)<>1
+ OR EXISTS (SELECT 1 FROM agent_run_writer_retirements WHERE run_id=NEW.run_id OR completion_id=NEW.completion_id)
+ OR NOT EXISTS (SELECT 1 FROM agent_run_writer_intents w WHERE w.run_id=NEW.run_id
+   AND w.session_key=NEW.session_key AND w.session_id=NEW.session_id AND w.created_at=NEW.writer_created_at)
+ OR EXISTS (SELECT 1 FROM agent_run_native_revocations q WHERE q.run_id=NEW.run_id
+   OR q.session_key=NEW.session_key OR q.session_id=NEW.session_id)
+BEGIN SELECT RAISE(ABORT,'Writer retirement lacks original owned terminal admission'); END;
+CREATE TRIGGER IF NOT EXISTS agent_run_writer_retirements_no_update
+BEFORE UPDATE ON agent_run_writer_retirements
+BEGIN SELECT RAISE(ABORT,'Writer retirement evidence cannot be rewritten'); END;
+CREATE TRIGGER IF NOT EXISTS agent_run_writer_retirements_no_delete
+BEFORE DELETE ON agent_run_writer_retirements
+BEGIN SELECT RAISE(ABORT,'Writer retirement evidence cannot be deleted'); END;
+CREATE TRIGGER IF NOT EXISTS session_nodes_retired_writer_insert_guard
+BEFORE INSERT ON session_nodes WHEN json_valid(NEW.entry_json)
+ AND EXISTS (SELECT 1 FROM json_each(NEW.entry_json) j JOIN agent_run_writer_retirements r ON r.run_id=j.value
+   WHERE j.key='activeWriterRunId' AND j.type='text')
+BEGIN SELECT RAISE(ABORT,'Retired writer run id cannot be reused'); END;
+CREATE TRIGGER IF NOT EXISTS session_nodes_retired_writer_update_guard
+BEFORE UPDATE ON session_nodes WHEN json_valid(NEW.entry_json)
+ AND EXISTS (SELECT 1 FROM json_each(NEW.entry_json) j JOIN agent_run_writer_retirements r ON r.run_id=j.value
+   WHERE j.key='activeWriterRunId' AND j.type='text')
+BEGIN SELECT RAISE(ABORT,'Retired writer run id cannot be reused'); END;
+CREATE TRIGGER IF NOT EXISTS session_pending_inputs_retired_writer_insert_guard
+BEFORE INSERT ON session_pending_inputs
+WHEN EXISTS(SELECT 1 FROM agent_run_writer_retirements WHERE run_id=NEW.run_id)
+BEGIN SELECT RAISE(ABORT,'Retired writer run id cannot be reused'); END;
+CREATE TRIGGER IF NOT EXISTS session_pending_inputs_retired_writer_update_guard
+BEFORE UPDATE ON session_pending_inputs
+WHEN EXISTS(SELECT 1 FROM agent_run_writer_retirements WHERE run_id=NEW.run_id)
+BEGIN SELECT RAISE(ABORT,'Retired writer run id cannot be reused'); END;
+-- END AGENT RUN QUARANTINE SCHEMA
+
+-- BEGIN NATIVE REVIEW PUBLICATION INTENT SCHEMA
+CREATE TABLE IF NOT EXISTS native_review_publication_intents (
+  intent_digest TEXT PRIMARY KEY CHECK(length(intent_digest)=64 AND intent_digest NOT GLOB '*[^0-9a-f]*'),
+  scope_json TEXT NOT NULL CHECK(json_valid(scope_json) AND json_type(scope_json)='object'),
+  repository TEXT NOT NULL,
+  pr_number INTEGER NOT NULL CHECK(pr_number>0),
+  head_sha TEXT NOT NULL CHECK(length(head_sha)=40 AND head_sha NOT GLOB '*[^0-9a-f]*'),
+  base_sha TEXT NOT NULL CHECK(length(base_sha)=40 AND base_sha NOT GLOB '*[^0-9a-f]*'),
