+    ![source.agentId, source.runId, source.instanceId, source.sessionKey, source.sessionId].every(
+      (value) => text(value, 256),
+    ) ||
+    !record(source.request)
+  )
+    throw new Error("Original review run/purpose facts are incomplete");
