+export function runWithGuardedFetchRequestAuthority<T>(
+  assertCurrent: (() => void) | undefined,
+  run: () => T,
+): T {
+  const inherited = requestAuthority.getStore();
+  if (!assertCurrent) {
+    inherited?.();
+    return run();
+  }
+  const assertAuthority = () => {
+    inherited?.();
+    const result: unknown = assertCurrent();
+    if (isPromiseLike(result)) {
+      void Promise.resolve(result).catch(() => undefined);
+      throw new TypeError("Guarded request authority must be synchronous.");
+    }
+  };
+  assertAuthority();
+  // Admission owns revocation. Returning the logical stream neither releases
+  // the run nor fences the provider work that its producer still owns.
+  return requestAuthority.run(assertAuthority, run);
+}
