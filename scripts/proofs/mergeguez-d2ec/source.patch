+  const authorId = number(target.authorId), reviewerId = number(target.reviewerId);
+  if (authorId === reviewerId || authorLogin.toLowerCase() === "mergeguez[bot]") throw new Error("Review author cannot be its reviewer");
+  return Object.freeze({
+    agentId: text(original.agentId), runId: text(original.runId), instanceId: text(original.instanceId),
+    sessionKey: text(original.sessionKey, 1024), sessionId: text(original.sessionId),
+    gatewayInstanceId: text(original.gatewayInstanceId), lifecycleGeneration: text(original.lifecycleGeneration),
+    sourceBuildSha256: hex(original.sourceBuildSha256, 64), purpose: "mergeguez-pr-review",
+    request: Object.freeze({ repository, prNumber, headSha: hex(target.headSha, 40), baseSha: hex(target.baseSha, 40),
+      commandCommentUrl, taskId: text(target.taskId), authorId, authorLogin, reviewerId, reviewer: "mergeguez[bot]",
+      event: target.event as NativeReviewTarget["event"], bodySha256: hex(target.bodySha256, 64),
+      inlineCommentsSha256: hex(target.inlineCommentsSha256, 64), inlineCommentsCount: number(target.inlineCommentsCount, 0, 80),
+      ingressDigest: hex(target.ingressDigest, 64), validatedOutputDigest: hex(target.validatedOutputDigest, 64),
+      requestDigest: hex(target.requestDigest, 64), intentDigest: hex(target.intentDigest, 64) })
+  });
+}
