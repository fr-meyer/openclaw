+}
+export function mergeguezReviewIngressDigest(request: MergeguezReviewRequest): string {
+  return hashMergeguezReviewData({ schema: "original-mergeguez-review-ingress/v1", request });
+}
+export type ValidatedMergeguezReviewOutput = Readonly<{
+  ingressDigest: string; validatedOutputDigest: string;
+  status: "approved" | "changes_requested" | "failed";
+  summary: string; findings: readonly MergeguezReviewFinding[]; blockingFindingsCount: number;
+}>;
