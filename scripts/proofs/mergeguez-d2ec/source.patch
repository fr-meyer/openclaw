diff --git a/scripts/proofs/native-ipc-gateway/native-fixture.ts b/scripts/proofs/native-ipc-gateway/native-fixture.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1962eb8b80a6e556825448ce7383ddf2fd629767
--- /dev/null
+++ b/scripts/proofs/native-ipc-gateway/native-fixture.ts
@@ -0,0 +1,54 @@
+import { isMainThread, threadId } from "node:worker_threads";
+import { openNodeSqliteDatabase } from "../../../src/plugin-sdk/sqlite-worker-runtime.js";
+import { runSqliteImmediateTransactionSync, requestSqliteWorkerOperationAdmission } from "../../../src/plugin-sdk/sqlite-worker-runtime.js";
+import { deferSqliteWorkerCommitReceipt } from "../../../src/infra/sqlite-worker-operation-admission.js";
+import { deferSqlitePostCommitPublication } from "../../../src/infra/sqlite-post-commit.js";
+import type { SqliteWorkerBackend } from "../../../src/infra/sqlite-worker-contract.js";
+
+type Operations = {
+  reserve: { input: { key: string }; output: { key: string; kind: "reserved"; threadId: number } };
+  commit: { input: { key: string }; output: { key: string; kind: "committed"; threadId: number } };
+  lostAck: { input: { key: string }; output: never };
+  read: { input: undefined; output: Record<string, unknown>[] };
+};
+
+/** Only fixture data is synthetic. SQLite, broker, admission port and native ACK owners are original. */
+export function createSqliteWorkerBackend(
+  _input: unknown,
+  context: { databasePath: string },
+): SqliteWorkerBackend<Operations> {
+  if (isMainThread) throw new Error("Fixture must execute in the original broker's Worker");
+  const database = openNodeSqliteDatabase(context.databasePath);
+  database.exec("CREATE TABLE IF NOT EXISTS qualification_reservations (key TEXT PRIMARY KEY, committed INTEGER NOT NULL CHECK (committed IN (0,1))) STRICT"); // sqlite-allow-raw -- Task fixture owner only.
+  function write<Kind extends "reserved" | "committed">(key: string, kind: Kind, lostAck: boolean) {
+    if (!key || key.includes("\0")) throw new Error("Fixture key must be exact");
+    const facts = { key, kind, threadId };
+    return runSqliteImmediateTransactionSync(database, () => {
+      requestSqliteWorkerOperationAdmission({ stage: "transaction", facts });
+      if (kind === "reserved") database.prepare("INSERT INTO qualification_reservations VALUES (?,0)").run(key);
+      else {
+        const result = database.prepare("UPDATE qualification_reservations SET committed=1 WHERE key=? AND committed=0").run(key);
+        if (result.changes !== 1) throw new Error("Commit requires one original reservation");
+      }
+      requestSqliteWorkerOperationAdmission({ stage: "commit", facts });
+      if (lostAck && !deferSqlitePostCommitPublication(database, () => process.exit(17)))
+        throw new Error("Actual post-COMMIT fault seam unavailable");
+      // Lost ACK exits this genuine Worker before this original protocol observer can publish.
+      deferSqliteWorkerCommitReceipt(database, facts);
+      return facts;
+    });
+  }
+  return {
+    execute(command) {
+      if (command.type === "read") return database.prepare("SELECT key,committed FROM qualification_reservations ORDER BY key").all();
+      if (command.type === "reserve") return write(command.input.key, "reserved", false);
+      if (command.type === "commit") return write(command.input.key, "committed", false);
+      write(command.input.key, "committed", true);
+      throw new Error("Native post-COMMIT worker exit was not reached");
+    },
+    assertSettled() {
+      if (database.isTransaction) throw new Error("Native fixture transaction remains unsettled");
+    },
+    close() { database.close(); },
+  };
+}
