+// Dormant source-owned proof entry. Only the sealed native phase calls this.
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import {pathToFileURL} from 'node:url';
+import {openWorkboardRecoveryQualificationStore, issueSqliteWorkerPrivateRecoveryAuthority, drainGlobalSingletonLifecycleState} from './native-api.js';
+
+const PROFILE = 'workboard-native-worker-logical-recovery.synthetic.v1';
+const STATE = '/qualification/native-state/workboard-proof';
+const CUSTODY = '/qualification/native-output/workboard-proof-custody';
+const WORKER = '/artifact/dist/extensions/workboard/src/sqlite-store.worker.js';
+const COMPANION = 'file:///proof/workboard-custody/worker-custody-bridge.mjs';
+const fail = code => { const error = new Error(code); error.code = code; throw error; };
+
+function prepareExclusiveDirectory(directory) {
+  const parent = path.dirname(directory), before = fs.lstatSync(parent);
+  if (!before.isDirectory() || before.isSymbolicLink() || before.uid !== process.geteuid() ||
+      (before.mode & 0o777) !== 0o700 || fs.realpathSync(parent) !== parent) fail('SYNTHETIC_PARENT_CUSTODY_INVALID');
+  fs.mkdirSync(directory, {mode: 0o700});
+  const opened = fs.lstatSync(directory);
+  if (!opened.isDirectory() || opened.isSymbolicLink() || opened.uid !== process.geteuid() ||
+      opened.dev !== before.dev || (opened.mode & 0o777) !== 0o700) fail('SYNTHETIC_DIRECTORY_CUSTODY_INVALID');
+}
+
+function checkedAcknowledgement(ack) {
+  if (!ack || ack.contract !== 'workboard.native-runtime-logical-recovery.v1' || ack.kind !== 'capture' ||
+      ack.synthetic !== true || ack.productionAcceptance !== false || ack.fullRecoveryReady !== false ||
+      ack.privateProofKept !== true || ack.rawProofPublished !== false || ack.runtimeStartAllowed !== false ||
+      ack.claimsRearmed !== false || ack.notificationsDelivered !== false) fail('SYNTHETIC_CUSTODY_ACK_INVALID');
+  return ack;
+}
+
+/**
+ * The caller is the actual admitted native-phase owner, not a grant DTO.
+ * Fresh directories and the original store belong to this one invocation.
+ * Its UUID/profile fields describe receipts; only retained closures admit work.
+ */
+export async function runWorkboardPrivateRecoveryQualification(context) {
+  if (!context || Object.keys(context).sort().join(',') !== 'assertCurrent,profileSha256,python' ||
+      typeof context.assertCurrent !== 'function' || !/^[0-9a-f]{64}$/.test(context.profileSha256) ||
+      context.python !== '/usr/bin/python3') fail('SYNTHETIC_NATIVE_CONTEXT_INVALID');
+  const parentCurrent = context.assertCurrent, profileSha256 = context.profileSha256, python = context.python;
+  let active = true, store, custodian, issued, primary, result, failed = false, captureInvoked = false;
+  const assertCurrent = () => {
+    if (!active) fail('SYNTHETIC_NATIVE_OWNER_RETIRED');
+    parentCurrent();
+    if (!active) fail('SYNTHETIC_NATIVE_OWNER_RETIRED');
+  };
+  const sourceBootId = crypto.randomUUID(), sourceGenerationId = crypto.randomUUID();
+  const operationId = crypto.randomUUID();
+  try {
+    assertCurrent();
+    prepareExclusiveDirectory(STATE);
+    assertCurrent();
+    prepareExclusiveDirectory(CUSTODY);
+    assertCurrent();
+    // Package graph and proof source pins are admitted by the original producer.
+    const {createWorkerCustodian} = await import(COMPANION);
+    assertCurrent();
+    store = await openWorkboardRecoveryQualificationStore({
+      dbPath: path.join(STATE, 'store.sqlite'), workerModuleUrl: pathToFileURL(WORKER),
+    }, assertCurrent);
+    assertCurrent();
+    await store.ready();
+    assertCurrent();
+    const target = await store.preparePrivateRecoveryTarget();
+    assertCurrent();
+    custodian = createWorkerCustodian({
+      sourceBinding: {sourceBootId, sourceGenerationId, sourceOwnerId: 'workboard-native-' + sourceGenerationId, profileSha256},
+      executionBootId: crypto.randomUUID(), python, custodyRoot: CUSTODY, sizeLimit: 4 * 1024 * 1024,
+    });
+    // This is the same executed internal issuer used by the genuine SDK target.
+    issued = issueSqliteWorkerPrivateRecoveryAuthority(target, {assertCurrent, custodian});
+    assertCurrent();
+    await custodian.ready(assertCurrent);
+    assertCurrent();
+    const card = await store.create({title: 'Synthetic recovery sentinel', status: 'todo', labels: ['synthetic-proof']}, undefined, assertCurrent);
+    assertCurrent();
+    await store.addAttachment(card.id, {
+      fileName: 'synthetic.txt', contentBase64: Buffer.from('synthetic recovery bytes\n').toString('base64'), mimeType: 'text/plain',
+    }, undefined, assertCurrent);
+    assertCurrent();
+    captureInvoked = true;
+    const ack = checkedAcknowledgement(await store.capturePrivateRecovery(issued.authority, operationId));
+    assertCurrent();
+    issued.revoke();
+    let revokedRejected = false;
+    try { await store.capturePrivateRecovery(issued.authority, crypto.randomUUID()); }
+    catch (error) { if (error?.code === 'closed') revokedRejected = true; else throw error; }
+    if (!revokedRejected) fail('REVOKED_PRIVATE_CAPTURE_ADMITTED');
+    result = {
+      schema: PROFILE, completed: true, synthetic: true, productionAcceptance: false, fullRecoveryReady: false,
+      originalFactoryTargetIssuerJoined: true, revokedCallRejected: true, fixtureCards: 1, fixtureAttachments: 1,
+      prePersistenceInertReconstruction: true, postAcknowledgementRestoreQualified: false,
+      acknowledgement: ack, runtimeStartAllowed: false, claimsRearmed: false, notificationsDelivered: false,
+    };
+  } catch (error) { failed = true; primary = error; }
+  // Revoke before yielding to joined shutdown; keep both owners even if one close fails.
+  active = false;
+  const cleanupCodes = [];
+  try { issued?.revoke(); } catch { cleanupCodes.push('PRIVATE_AUTHORITY_REVOKE_FAILED'); }
+  for (const [owner, code] of [[store, 'WORKBOARD_STORE_CLOSE_FAILED'], [custodian, 'CUSTODIAN_CLOSE_FAILED']]) {
+    try { await owner?.close(); } catch { cleanupCodes.push(code); }
+  }
+  // This isolated phase has no other core user: join the original broker owner too.
+  try { await drainGlobalSingletonLifecycleState(); } catch { cleanupCodes.push('SQLITE_BROKER_DRAIN_FAILED'); }
+  if (cleanupCodes.length || failed) {
+    const error = new Error(cleanupCodes.length ? 'SYNTHETIC_NATIVE_CLEANUP_FAILED' : 'SYNTHETIC_NATIVE_OPERATION_FAILED', {cause: primary});
+    const code = primary && (typeof primary === 'object' || typeof primary === 'function') ? Object.getOwnPropertyDescriptor(primary, 'code')?.value : undefined;
+    error.code = typeof code === 'string' ? code : cleanupCodes.length ? 'SYNTHETIC_NATIVE_CLEANUP_FAILED' : 'SYNTHETIC_NATIVE_OPERATION_FAILED';
