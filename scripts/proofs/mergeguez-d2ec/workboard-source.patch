@@ -0,0 +1,28 @@
+import type { DatabaseSync } from "node:sqlite";
+import { requestSqliteWorkerOperationAdmission } from "openclaw/plugin-sdk/sqlite-worker-runtime";
+import { captureOwnedDatabase, snapshotBytes, verifySnapshotBytes, canonical } from "./private-recovery/native-memory-codec.mjs";
+import { LOGICAL_ASSURANCE, assertCaptureInterval } from "./private-recovery/logical-assurance.mjs";
+
+export type WorkboardPrivateCaptureInput = {
+  connection: number; operationId: string; nonce: string;
+};
+
+/** The original worker-held handle is captured; no operational path is reopened. */
+export function captureWorkboardOwnedDatabase(database: DatabaseSync, input: WorkboardPrivateCaptureInput): Uint8Array {
+  const facts = { kind: "private-recovery.capture", ...input };
+  requestSqliteWorkerOperationAdmission({ stage: "prepare", facts });
+  const startedAtMs = Date.now(), started = performance.now();
+  const captured = captureOwnedDatabase(database, {
+    onSnapshotStart() { requestSqliteWorkerOperationAdmission({ stage: "transaction", facts }); },
+    onBeforeCommit() { requestSqliteWorkerOperationAdmission({ stage: "commit", facts }); },
+  });
+  const captureInterval = assertCaptureInterval({
+    startedAtMs, completedAtMs: Date.now(), elapsedMs: Math.ceil(performance.now() - started),
+    cutoff: LOGICAL_ASSURANCE.source.readCutoff, exactCommitTimestampProven: false,
+  });
+  const snapshot = snapshotBytes(captured.exported);
+  verifySnapshotBytes(snapshot, captured.exported);
+  const payload = Buffer.from(canonical({ exported: captured.exported, snapshotBase64: Buffer.from(snapshot).toString("base64"), captureInterval }));
+  if (payload.byteLength > 32 * 1024 * 1024) throw new Error("Private recovery payload exceeds transport quota");
+  return payload;
+}
