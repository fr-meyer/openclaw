diff --git a/src/infra/sqlite-worker-private-recovery-authority.ts b/src/infra/sqlite-worker-private-recovery-authority.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ee8707b78eed4985702e0fc294cd5c8a4ad2f763
--- /dev/null
+++ b/src/infra/sqlite-worker-private-recovery-authority.ts
@@ -0,0 +1,149 @@
+import { randomUUID } from "node:crypto";
+import { SqliteWorkerError } from "./sqlite-worker-contract.js";
+import {
+  createSqliteWorkerOperationAdmission,
+  type SqliteWorkerAdmissionFactory,
+} from "./sqlite-worker-operation-admission.js";
+
+export const PRIVATE_RECOVERY_COMMAND = "private-recovery.capture";
+export type PrivateRecoveryCommand = {
+  type: typeof PRIVATE_RECOVERY_COMMAND;
+  input: { connection: number; operationId: string; nonce: string };
+};
+export type SqliteWorkerRecoveryTarget = Readonly<object>;
+export type SqliteWorkerPrivateRecoveryAuthority = Readonly<object>;
+type Target = {
+  actor: object;
+  connection: number;
+  assertCurrent(): void;
+  execute<T>(command: PrivateRecoveryCommand, factory: SqliteWorkerAdmissionFactory,
+             assertCurrent: () => void, consume: (result: unknown) => Promise<T>): Promise<T>;
+  decode(result: unknown): Uint8Array;
+};
+type Authority = {
+  target: Target;
+  assertOwnerCurrent(): void;
+  persist(payload: Uint8Array, operationId: string, assertCurrent: () => void): Promise<unknown>;
+  revoked: boolean;
+  operations: Set<string>;
+};
+const targets = new WeakMap<object, Target>();
+const authorities = new WeakMap<object, Authority>();
+const factories = new WeakMap<SqliteWorkerAdmissionFactory, {
+  target: Target; command: PrivateRecoveryCommand; assertCurrent(): void;
+  active: boolean; dispatched: boolean; grants: number;
+}>();
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+const fail = () => { throw new SqliteWorkerError("Private recovery authority is unavailable", "closed"); };
+
+/** Internal registration, called by the existing broker facade, never a private grant. */
+export function registerSqliteWorkerRecoveryTarget(target: Target): SqliteWorkerRecoveryTarget {
+  target.assertCurrent();
+  if (!Number.isSafeInteger(target.connection) || target.connection <= 0) fail();
+  const handle = Object.freeze({});
+  targets.set(handle, { ...target });
+  return handle;
+}
+
+/** Host-only issuer. Deliberately absent from SDK exports and model/Gateway routes. */
+export function issueSqliteWorkerPrivateRecoveryAuthority(
+  targetHandle: SqliteWorkerRecoveryTarget,
+  owner: {
+    assertCurrent(): void;
+    custodian: { persist(payload: Uint8Array, operationId: string, assertCurrent: () => void): Promise<unknown> };
+  },
+): { authority: SqliteWorkerPrivateRecoveryAuthority; revoke(): void } {
+  const target = targets.get(targetHandle);
+  if (!target || typeof owner.assertCurrent !== "function" || typeof owner.custodian.persist !== "function") fail();
+  const assertOwnerCurrent = owner.assertCurrent.bind(owner);
+  const persist = owner.custodian.persist.bind(owner.custodian);
+  assertOwnerCurrent();
+  target.assertCurrent();
+  const authority = Object.freeze({});
+  const state: Authority = { target, assertOwnerCurrent, persist, revoked: false, operations: new Set() };
+  authorities.set(authority, state);
+  return Object.freeze({ authority, revoke() { state.revoked = true; } });
+}
+
+/** Broker client checks the actual serialized command against its opaque factory. */
+export function assertSqliteWorkerPrivateRecoveryCommand(
+  command: { type: PropertyKey; input: unknown }, actor: object,
+  factory: SqliteWorkerAdmissionFactory | undefined,
+): void {
+  if (typeof command.type !== "string" || !command.type.startsWith("private-recovery.")) return;
+  const state = factory && factories.get(factory);
+  if (!state || !state.active || state.dispatched || state.target.actor !== actor || command.type !== PRIVATE_RECOVERY_COMMAND) fail();
+  const input = command.input;
+  if (!input || typeof input !== "object" || Array.isArray(input)) fail();
+  const fields = Object.getOwnPropertyDescriptors(input);
+  if (Object.keys(fields).sort().join(",") !== "connection,nonce,operationId" ||
+      fields.connection?.value !== state.command.input.connection ||
+      fields.operationId?.value !== state.command.input.operationId ||
+      fields.nonce?.value !== state.command.input.nonce) fail();
+  state.assertCurrent();
+  state.dispatched = true;
+}
+
+/** Keep the original broker operation until private descriptor custody acknowledges it. */
+export async function capturePrivateSqliteWorkerRecovery(
+  targetHandle: SqliteWorkerRecoveryTarget,
+  capability: SqliteWorkerPrivateRecoveryAuthority,
+  operationId: string,
+): Promise<unknown> {
+  const target = targets.get(targetHandle), owner = authorities.get(capability);
+  if (!target || !owner || owner.target !== target || !UUID.test(operationId) || owner.operations.has(operationId) || owner.operations.size >= 1024) fail();
+  const assertCurrent = () => {
+    if (owner.revoked) fail();
+    owner.assertOwnerCurrent();
+    target.assertCurrent();
+    // A source-owned check can synchronously reenter retirement before returning.
+    if (owner.revoked) fail();
+  };
+  assertCurrent();
+  owner.operations.add(operationId);
+  const command: PrivateRecoveryCommand = Object.freeze({
+    type: PRIVATE_RECOVERY_COMMAND,
+    input: Object.freeze({ connection: target.connection, operationId, nonce: randomUUID() }),
+  });
+  let active = true;
+  const factory: SqliteWorkerAdmissionFactory = () => {
+    let phase = 0;
+    return {
+      nativeLocations: [],
+      admission: createSqliteWorkerOperationAdmission((request, grant) => {
+        if (!active) fail();
+        assertCurrent();
+        const facts = request.facts;
+        if (!facts || typeof facts !== "object" || Array.isArray(facts)) fail();
+        const fields = Object.getOwnPropertyDescriptors(facts);
+        if (Object.keys(fields).sort().join(",") !== "connection,kind,nonce,operationId" ||
+            fields.kind?.value !== PRIVATE_RECOVERY_COMMAND ||
+            fields.connection?.value !== command.input.connection ||
+            fields.operationId?.value !== operationId || fields.nonce?.value !== command.input.nonce ||
+            request.stage !== ["prepare", "transaction", "commit"][phase]) fail();
+        if (!grant()) fail();
+        phase++;
+        factoryState.grants = phase;
+      }),
+    };
+  };
+  const factoryState = { target, command, assertCurrent, active: true, dispatched: false, grants: 0 };
+  factories.set(factory, factoryState);
+  try {
+    return await target.execute(command, factory, assertCurrent, async (result) => {
+      assertCurrent();
+      if (factoryState.grants !== 3) fail();
+      const bytes = target.decode(result);
+      if (!(bytes instanceof Uint8Array) || bytes.byteLength > 32 * 1024 * 1024) fail();
+      assertCurrent();
+      const receipt = await owner.persist(bytes, operationId, assertCurrent);
+      try { assertCurrent(); }
+      catch { throw new SqliteWorkerError("Private recovery acknowledgement is unknown", "outcome-unknown"); }
+      return receipt;
+    });
+  } finally {
+    active = false;
+    factoryState.active = false;
+    factories.delete(factory);
+  }
+}
