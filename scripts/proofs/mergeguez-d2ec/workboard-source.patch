@@ -0,0 +1,7 @@
+import type { DatabaseSync } from "node:sqlite";
+export function captureOwnedDatabase(database: DatabaseSync, admission: {
+  onSnapshotStart(): void; onBeforeCommit(): void;
+}): { exported: unknown; diagnostics: unknown; cardRevisions: unknown };
