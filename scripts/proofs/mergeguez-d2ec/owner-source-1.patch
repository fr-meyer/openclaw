+import { describe, expect, it, vi } from "vitest";
+import type { SubagentRunRecord } from "../agents/subagents/registry/subagent-registry.types.js";
+import type { ManagedTaskSubagentRequest } from "./managed-task-flow-contract.js";
+import {
+  assertManagedTaskSubagentModel,
+  assertManagedTaskSubagentSource,
+  bindManagedTaskSubagentModel,
+  bindManagedTaskSubagentRegistration,
+  bindManagedTaskSubagentRun,
+  createManagedTaskFlowHost,
+  getManagedTaskSubagentRegistration,
+  readManagedTaskSubagentIdentity,
+  retainManagedTaskSubagentExecution,
+  retainManagedTaskSubagentPublication,
+  type ManagedTaskSubagentSource,
+} from "./managed-task-flow-host.js";
+
+// Unit fixtures model an already-issued original Gateway host. Origin refusal is
+// tested separately against the actual Gateway private lookup and preflight.
+const originalHostFixture = vi.hoisted(() => new WeakSet<object>());
+vi.mock("../gateway/server-managed-task-flow-runtime.js", () => ({
+  assertGatewayManagedTaskFlowHostCurrent(host: object) {
+    if (!originalHostFixture.has(host)) {
+      throw new Error("Missing original Gateway host fixture");
+    }
+  },
+}));
+
+function deferred() {
+  let resolve = () => {};
+  let reject = (_error: unknown) => {};
+  const promise = new Promise<void>((settle, fail) => {
+    resolve = settle;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+const request: ManagedTaskSubagentRequest = {
+  sessionKey: "agent:ops:subagent:child",
+  sessionId: "fresh-child-session",
+  idempotencyKey: "child-run",
+  message: "complete bounded input",
+  requiredExecutionClosure: "native-sse-no-tools",
+};
+function fixture(
+  run: (source: ManagedTaskSubagentSource, capturedRequest: ManagedTaskSubagentRequest) => Promise<void>,
+) {
+  let parentCurrent = true;
+  let retireParent: (reason: unknown) => void = () => {};
+  const host = createManagedTaskFlowHost({
+    assertCurrent() {},
+    bindSessionAuthority: () => ({
+      ownerKey: "agent:ops:main", controllerId: "example/v1",
+      assertCurrent() {}, assertOwnerSelection() {}, legacyOwnerObservation: false,
+    }),
+    execute: async () => { throw new Error("No state transport in host fixture"); },
+    cancel: async () => { throw new Error("No cancellation transport in host fixture"); },
+    subagent: {
+      signal: new AbortController().signal,
+      prepare: async () => ({
+        registration: {
+          flowId: "flow", ownerKey: "agent:ops:main", controllerId: "example/v1",
+          expectedRevision: 3, pluginId: "example", runId: "child-run",
+          childSessionKey: request.sessionKey, sessionId: "fresh-child-session",
+        },
+        assertParentCurrent() { if (!parentCurrent) { throw new Error("Native parent retired"); } },
+        watchParent(onRetired) { retireParent = onRetired; return () => {}; },
+      }),
+      run: async (capturedRequest, source) => {
+        await run(source, capturedRequest);
+        return { runId: "child-run" };
+      },
+    },
+  });
+  originalHostFixture.add(host);
+  const bound = host.managedFlows.bindSession({ sessionKey: "agent:ops:main" });
+  return {
+    host, bound,
+    launch: () => bound.launchSubagent({ flowId: "flow", expectedRevision: 3, request }),
+    cancelParent: () => { parentCurrent = false; retireParent(new Error("Native parent retired")); },
+  };
+}
+function publish(source: ManagedTaskSubagentSource) {
+  getManagedTaskSubagentRegistration(source, { runId: "child-run", sessionKey: request.sessionKey });
+  const entry: SubagentRunRecord = {
+    runId: "child-run", taskRunId: "child-run", childSessionKey: request.sessionKey,
+    requesterSessionKey: "agent:ops:main", controllerSessionKey: "agent:ops:main",
+    requesterDisplayKey: "main", task: request.message, cleanup: "keep", label: "plugin:example",
+    parentFlowId: "flow", parentFlowRevision: 3, generation: 1, createdAt: 10,
+    execution: { status: "running", startedAt: 10 },
+    completion: { required: false }, delivery: { status: "not_required" },
+  };
+  bindManagedTaskSubagentRegistration(source, { entry, assertCurrent() {} });
+  bindManagedTaskSubagentRun(source, {
+    operationalRunInstance: { instanceId: "instance", runId: "child-run" },
+    runId: "child-run", sessionKey: request.sessionKey, sessionId: "fresh-child-session",
+  });
+  return entry;
+}
+
+describe("original managed task-flow subagent owner", () => {
+  it("rejects copied source identity and redirects, and consumes registration once", async () => {
+    const f = fixture(async (source) => {
+      expect(() => assertManagedTaskSubagentSource({ ...source }, {
+        runId: "child-run", sessionKey: request.sessionKey,
+      })).toThrow("original bound task source");
+      expect(() => assertManagedTaskSubagentSource(source, {
+        runId: "another-run", sessionKey: request.sessionKey,
+      })).toThrow("captured native owner");
+      publish(source);
+      expect(() => getManagedTaskSubagentRegistration(source, {
+        runId: "child-run", sessionKey: request.sessionKey,
+      })).toThrow("already consumed");
+      expect(readManagedTaskSubagentIdentity(source)).toMatchObject({
+        runId: "child-run", taskRunId: "child-run", generation: 1, flowId: "flow", revision: 3,
+      });
+    });
+    await f.launch();
+    await f.host.close();
+  });
+
+  it("captures request bytes, callback and signal before asynchronous admission", async () => {
+    let checks = 0;
+    const controller = new AbortController();
+    const supplied = { ...request, message: "original bytes", signal: controller.signal,
+      assertCurrent: () => { checks++; } };
+    const f = fixture(async (_source, captured) => {
+      expect(captured.message).toBe("original bytes");
+      expect(captured.idempotencyKey).toBe("child-run");
+    });
+    const launched = f.bound.launchSubagent({ flowId: "flow", expectedRevision: 3, request: supplied });
+    supplied.message = "redirected bytes";
+    supplied.idempotencyKey = "redirected run";
+    supplied.assertCurrent = () => { throw new Error("Replaced callback"); };
+    supplied.signal = new AbortController().signal;
+    await launched;
+    expect(checks > 0).toBe(true);
+    await f.host.close();
+
+    const aborted = { ...request, signal: controller.signal };
+    const next = fixture(async () => { throw new Error("Transport must not execute"); });
+    const narrowed = next.bound.launchSubagent({ flowId: "flow", expectedRevision: 3, request: aborted });
+    aborted.signal = new AbortController().signal;
+    controller.abort(new Error("Original caller cancelled"));
+    await expect(narrowed).rejects.toThrow("Original caller cancelled");
+    await next.host.close();
+  });
+
+  it("binds only the selected original prepared model", async () => {
+    const f = fixture(async (source) => {
+      expect(() => assertManagedTaskSubagentModel(source, { provider: "p", model: "m" })).toThrow();
+      bindManagedTaskSubagentModel(source, { provider: "p", model: "m" });
+      assertManagedTaskSubagentModel(source, { provider: "p", model: "m" });
+      expect(() => assertManagedTaskSubagentModel(source, { provider: "p", model: "other" })).toThrow();
+      expect(() => bindManagedTaskSubagentModel(source, { provider: "p", model: "m" })).toThrow();
+    });
+    await f.launch();
+    await f.host.close();
+  });
+
+  it("keeps physical execution after the response and preserves receipt custody after drain", async () => {
+    const execution = deferred();
+    let source: ManagedTaskSubagentSource | undefined;
+    const f = fixture(async (current) => { source = current; publish(current); retainManagedTaskSubagentExecution(current, execution.promise); });
+    await f.launch();
+    let drained = false;
+    void execution.promise.then(() => { drained = true; });
+    expect(drained).toBe(false);
+    execution.resolve();
+    await execution.promise;
+    expect(source).toBeDefined();
+    if (!source) { throw new Error("Missing captured original source"); }
+    source.assertReceiptCurrent();
+    const closing = f.host.close();
+    await closing;
