+describe("agent snapshot migration target schema", () => {
+  it("installs current guards and backfills native writers when storage is already migrated", async () => {
+    await withOpenClawTestState({ scenario: "minimal" }, async (state) => {
+      const pathname = state.path("pre-snapshot.sqlite");
+      const database = new DatabaseSync(pathname);
+      try {
+        database.exec(getOpenClawAgentMigrationSchema(23));
+        database.exec(`PRAGMA user_version = 23;
+          INSERT INTO schema_meta (meta_key, role, schema_version, agent_id, created_at, updated_at)
+          VALUES ('primary', 'agent', 23, 'main', 1, 1)`);
+        insertNode(database, key, "target");
+        database
+          .prepare("UPDATE session_nodes SET entry_json = ? WHERE session_key = ?")
+          .run(
+            JSON.stringify({ sessionId: "target", updatedAt: 1, activeWriterRunId: "pre-snapshot-run" }),
+            key,
+          );
+        const before = database.prepare("SELECT *, 0 AS snapshot_revision FROM session_nodes").all();
+        await withAgentDatabaseMaintenanceLease({ env: state.env }, async () => {
+          ensureOpenClawAgentDatabaseSchema(database, {
+            agentId: "main",
+            env: state.env,
+            path: pathname,
+          });
+        });
+        expect(database.prepare("SELECT * FROM session_nodes").all()).toEqual(before);
+        expect(database.prepare("PRAGMA user_version").get()?.user_version).toBe(
+          OPENCLAW_AGENT_SCHEMA_VERSION,
+        );
+        expect(
+          database
+            .prepare("SELECT schema_version FROM schema_meta WHERE meta_key = 'primary'")
+            .get()?.schema_version,
+        ).toBe(OPENCLAW_AGENT_SCHEMA_VERSION);
+        expect(database.prepare("SELECT * FROM session_entry_snapshots").all()).toEqual([]);
+        assertCanonicalSessionValidationSchema(database);
+        expect(
+          database
+            .prepare(`SELECT run_id, session_key, session_id, created_at, evidence_kind
+              FROM agent_run_writer_intents WHERE run_id = 'pre-snapshot-run'`)
+            .get(),
+        ).toEqual({
+          run_id: "pre-snapshot-run",
+          session_key: key,
+          session_id: "target",
+          created_at: 1,
+          evidence_kind: "native-writer-persisted",
+        });
+      } finally {
+        database.close();
+      }
+    });
+  });
+});
