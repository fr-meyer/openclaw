#!/usr/bin/env bash
set -Eeuo pipefail
workspace= image= timeout= label=
command=()
while (($#)); do
 case "$1" in
 --workspace) workspace=$2; shift 2;;
 --image) image=$2; shift 2;;
 --timeout) timeout=$2; shift 2;;
 --label) label=$2; shift 2;;
 --command) shift; [[ ${1:-} != -- ]] || shift; command=("$@"); break;;
 *) printf 'unknown no-copy helper argument: %s\n' "$1" >&2; exit 2;;
 esac
done
[[ -n $workspace && -n $image && $timeout =~ ^[1-9][0-9]*$ && ${#command[@]} -gt 0 ]]
if [[ -z ${OPENCLAW_NO_COPY_CONFIG:-} || -z ${OPENCLAW_NO_COPY_RECEIPT:-} ]]; then
 echo NO_COPY_INTEGRATION_REQUIRED >&2; exit 78
fi
tools=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec node "$tools/full-validation.mjs" check "$OPENCLAW_NO_COPY_CONFIG" "$OPENCLAW_NO_COPY_RECEIPT" "$workspace" "$image" "$timeout" "$label" -- "${command[@]}"
