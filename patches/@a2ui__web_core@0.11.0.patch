+import { z } from './zod-runtime.js';
+/** Options actually used by the versioned A2UI catalog generators. */
+export interface CatalogJsonSchemaOptions {
+    target?: 'jsonSchema2019-09';
+    $refStrategy?: 'none';
+    /** Stable catalog-local resource name, distinct for components, functions and theme. */
+    name?: string;
+}
+/**
+ * Native Zod4 emits Draft2020-12, which A2UI catalogs support. Native Zod has
+ * no Draft2019-09 target. Keep input/default semantics and inline repeated
+ * schemas for the legacy `none` strategy, while retaining necessary cycle refs.
+ */
+export declare function zodToJsonSchema(schema: z.ZodType, options?: CatalogJsonSchemaOptions): z.core.JSONSchema.BaseSchema;
