+/** Native-v4's public discriminator also works across duplicate module instances. */
+export function isSchemaKind(schema, kind) {
+    return schema.type === kind;
+}
+/** Preprocessors validate their output; validator-only pipes expose the downstream shape. */
+export function pipeStructuralSchema(schema) {
+    return ['transform', 'any', 'unknown'].includes(schema.in.type) ? schema.out : schema.in;
