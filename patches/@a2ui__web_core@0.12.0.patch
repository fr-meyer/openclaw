 parts[1].replaceAll('~1', '/').replaceAll('~0', '~');\n        return [key, `#/$defs/${pointerToken(`${name}$${id}`)}${parts.length > 2 ? '/' + parts.slice(2).join('/') : ''}`];\n      }\n      return [key, `#/$defs/${pointerToken(name)}${child === '#' ? '' : child.slice(1)}`];\n    }));\n  };\n  const rewritten = rewrite(raw) as z.core.JSONSchema.BaseSchema;\n  if (!hasLocalRefs) return raw;\n  const {$defs: _defs, $schema, ...body} = rewritten;\n  const relocatedDefs: Record<string, z.core.JSONSchema.BaseSchema> = {};\n  for (const id of Object.keys(definitions)) {\n    relocatedDefs[`${name}$${id}`] = rewritten.$defs![id];\n  }\n  relocatedDefs[name] = body;\n  return {...body, $schema, $defs: relocatedDefs};\n}\n\n/**\n * Native Zod4 emits Draft2020-12, which A2UI catalogs support. Native Zod has\n * no Draft2019-09 target. Keep input/default semantics and inline repeated\n * schemas for the legacy `none` strategy, while retaining necessary cycle refs.\n */\nexport function zodToJsonSchema(\n  schema: z.ZodType,\n  options: CatalogJsonSchemaOptions = {},\n): z.core.JSONSchema.BaseSchema {\n  if (options.target !== undefined && options.target !== 'jsonSchema2019-09') {\n    throw new Error('Unsupported A2UI JSON Schema target');\n  }\n  if (options.$refStrategy !== undefined && options.$refStrategy !== 'none') {\n    throw new Error('Unsupported A2UI JSON Schema reference strategy');\n  }\n  const raw = z.toJSONSchema(schema, {\n    target: 'draft-2020-12', io: 'input', reused: 'inline', cycles: 'ref',\n  });\n  return preserveLocalReferences(raw, options.name ?? 'A2uiRoot');\n}\n"]}
